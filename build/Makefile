# Build rule for target.
intrinsics-cast-cuda: cmake_check_build_system
	$(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 intrinsics-cast-cuda
.PHONY : intrinsics-cast-cuda

# fast build rule for target.
intrinsics-cast-cuda/fast:
	$(MAKE) $(MAKESILENT) -f src/intrinsics-cast-cuda/CMakeFiles/intrinsics-cast-cuda.dir/build.make src/intrinsics-cast-cuda/CMakeFiles/intrinsics-cast-cuda.dir/build
.PHONY : intrinsics-cast-cuda/fast

