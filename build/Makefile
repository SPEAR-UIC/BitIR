# Build rule for target.
fresnel-all: cmake_check_build_system
	$(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 fresnel-all
.PHONY : fresnel-all

# fast build rule for target.
fresnel-all/fast:
	$(MAKE) $(MAKESILENT) -f src/fresnel-cuda/CMakeFiles/fresnel-all.dir/build.make src/fresnel-cuda/CMakeFiles/fresnel-all.dir/build
.PHONY : fresnel-all/fast

