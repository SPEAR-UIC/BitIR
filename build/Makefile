kurtosis-all: cmake_check_build_system
	$(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 kurtosis-all
.PHONY : kurtosis-all

# fast build rule for target.
kurtosis-all/fast:
	$(MAKE) $(MAKESILENT) -f src/kurtosis-cuda/CMakeFiles/kurtosis-all.dir/build.make src/kurtosis-cuda/CMakeFiles/kurtosis-all.dir/build
.PHONY : kurtosis-all/fast

