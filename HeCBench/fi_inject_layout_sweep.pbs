#!/bin/bash
#PBS -A UIC-HPC
#PBS -N layout_fi_inject
#PBS -q prod
#PBS -l select=100:ncpus=1:ngpus=4:mem=32gb
#PBS -l filesystems=home:eagle
#PBS -l walltime=10:00:00
#PBS -o OUT_layout_fi_inject.out
#PBS -e ERROR_layout_fi_inject.err

set -euo pipefail

export BENCH="layout"
export INJECT_TARGET="${INJECT_TARGET:-result}"
export INCLUDE_CONSTANTS="${INCLUDE_CONSTANTS:-0}"
export INT_FLOAT_ONLY="${INT_FLOAT_ONLY:-1}"
exec bash "${PBS_O_WORKDIR:-$(pwd)}/HeCBench/llvm17_inject_bench_sweep.pbs"
