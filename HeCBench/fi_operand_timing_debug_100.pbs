#!/bin/bash
#PBS -A UIC-HPC
#PBS -N fi_operand_timing_100
#PBS -q prod
#PBS -l select=10:ncpus=32:ngpus=1:mem=128gb
#PBS -l filesystems=home:eagle
#PBS -l walltime=01:00:00
#PBS -o OUT_operand_timing_100.out
#PBS -e ERROR_operand_timing_100.err

set -euo pipefail

if command -v module &> /dev/null; then
  module use /soft/modulefiles
  module purge
  module load spack-pe-base cmake
  module load cudatoolkit-standalone/11.8.0
  module load llvm/release-17.0.0
fi

cd "$PBS_O_WORKDIR"

# Clean logs per run
: > OUT_operand_timing_100.out
: > ERROR_operand_timing_100.err

REPO_ROOT="${REPO_ROOT:-$PBS_O_WORKDIR}"
export CUDA_HOME="${CUDA_HOME:-/soft/compilers/cudatoolkit/cuda-11.8.0}"
export PATH="${CUDA_HOME}/bin:${PATH:-}"
export LD_LIBRARY_PATH="${CUDA_HOME}/lib64:${LD_LIBRARY_PATH:-}"
export CUDA_DEVICE_ORDER="${CUDA_DEVICE_ORDER:-PCI_BUS_ID}"
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"

export INJECT_TARGET="operand"
export INT_FLOAT_ONLY="${INT_FLOAT_ONLY:-1}"
export INCLUDE_CONSTANTS="${INCLUDE_CONSTANTS:-0}"
export CACHE_DEVICE_IR="${CACHE_DEVICE_IR:-1}"
export GENERATE_IR_LL="${GENERATE_IR_LL:-0}"
export SKIP_EXISTING=0
export COMPARE_MODE="${COMPARE_MODE:-exact}"

echo "[env] REPO_ROOT=${REPO_ROOT}"
echo "[env] CUDA_HOME=${CUDA_HOME}"
echo "[env] CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES}"
echo "[env] INJECT_TARGET=${INJECT_TARGET} INT_FLOAT_ONLY=${INT_FLOAT_ONLY} INCLUDE_CONSTANTS=${INCLUDE_CONSTANTS}"
echo "[env] CACHE_DEVICE_IR=${CACHE_DEVICE_IR} GENERATE_IR_LL=${GENERATE_IR_LL}"
echo "[env] start=$(date)"

BENCHES=(atomicCost)
START_INDEX_ATOMICCOST="${START_INDEX_ATOMICCOST:-20}"

pick_worklist() {
  local bench="$1"
  local sycl_list="${REPO_ROOT}/HeCBench/results/llvm17_inject/${bench}-sycl/worklist_operand_sycl_aligned.csv"
  local fallback="${REPO_ROOT}/HeCBench/results/llvm17_inject/${bench}/worklist_operand.csv"
  if [[ -s "${sycl_list}" ]]; then
    echo "${sycl_list}"
  elif [[ -s "${fallback}" ]]; then
    echo "${fallback}"
  else
    echo ""
  fi
}

for bench in "${BENCHES[@]}"; do
  worklist="$(pick_worklist "${bench}")"
  if [[ -z "${worklist}" ]]; then
    echo "[warn] missing worklist for ${bench}, skipping"
    continue
  fi

  tmp_root="${PBS_JOBTMP:-/tmp}/fi-operand-timing/${bench}"
  mkdir -p "${tmp_root}"
  pair_list="${tmp_root}/pairs_100.csv"

  python3 - "${worklist}" "${pair_list}" "${bench}" "${START_INDEX_ATOMICCOST}" <<'PY'
import csv, sys
src, out, bench, start_idx = sys.argv[1], sys.argv[2], sys.argv[3], int(sys.argv[4])
with open(src, newline="") as fh, open(out, "w", newline="") as oh:
    r = csv.DictReader(fh)
    w = csv.writer(oh)
    w.writerow(["site_id","bit_index"])
    count = 0
    skip = start_idx - 1 if bench == "atomicCost" else 0
    for row in r:
        if skip > 0:
            skip -= 1
            continue
        if count >= 100:
            break
        site = row.get("site_id") or row.get("site") or row.get("Site") or row.get("SITE_ID")
        bit = row.get("bit_index") or row.get("bit") or row.get("BIT_INDEX")
        if site is None or bit is None:
            continue
        w.writerow([site, bit])
        count += 1
PY
  # Sanitize CRLF in case source list has Windows line endings
  tr -d '\r' < "${pair_list}" > "${pair_list}.clean"
  mv -f "${pair_list}.clean" "${pair_list}"

  count=$(tail -n +2 "${pair_list}" | wc -l | tr -d ' ')
  if [[ "${count}" -eq 0 ]]; then
    echo "[warn] no pairs found for ${bench}, skipping"
    continue
  fi

  echo "[bench] ${bench} pairs=${count}"
  out_dir="${tmp_root}/build"
  results_dir="${REPO_ROOT}/HeCBench/results/fi_operand_timing/${bench}"
  mkdir -p "${results_dir}"

  while IFS=, read -r site bit; do
    if [[ "${site}" == "site_id" || -z "${site}" ]]; then
      continue
    fi
    bit="${bit//$'\r'/}"
    site="${site//$'\r'/}"
    BENCH="${bench}" \
    SITE_ID="${site}" \
    BIT_INDEX="${bit}" \
    OUT_DIR="${out_dir}" \
    RESULTS_DIR="${results_dir}" \
    CUDA_HOME="${CUDA_HOME}" \
    INJECT_TARGET="${INJECT_TARGET}" \
    INT_FLOAT_ONLY="${INT_FLOAT_ONLY}" \
    INCLUDE_CONSTANTS="${INCLUDE_CONSTANTS}" \
    CACHE_DEVICE_IR="${CACHE_DEVICE_IR}" \
    GENERATE_IR_LL="${GENERATE_IR_LL}" \
    COMPARE_MODE="${COMPARE_MODE}" \
    bash "${REPO_ROOT}/HeCBench/tools/llvm17_inject/run_benchmark_injection.sh"
  done < "${pair_list}"

  python3 - "${results_dir}" <<'PY'
import glob, statistics, sys, re
results_dir = sys.argv[1]
times = []
for path in glob.glob(f"{results_dir}/site*_bit*.out"):
    try:
        with open(path) as fh:
            for line in fh:
                if line.startswith("timing_ms:"):
                    try:
                        times.append(float(line.split(":")[1].strip()))
                    except Exception:
                        pass
                    break
    except OSError:
        pass
if times:
    times.sort()
    def pct(p):
        idx = int(round((p/100.0) * (len(times)-1)))
        return times[idx]
    print(f"[timing] {results_dir} n={len(times)} p50_ms={pct(50):.2f} p90_ms={pct(90):.2f} max_ms={max(times):.2f}")
else:
    print(f"[timing] {results_dir} no timing_ms found")
PY
done

echo "[env] end=$(date)"
