#!/bin/bash
#PBS -A UIC-HPC
#PBS -N jacobi_operand_debug
#PBS -q debug
#PBS -l select=1:ncpus=1:ngpus=1:mem=16gb
#PBS -l filesystems=home:eagle
#PBS -l walltime=01:00:00
#PBS -o OUT_jacobi_operand_debug.out
#PBS -e ERROR_jacobi_operand_debug.err

set -euo pipefail

export BENCH="jacobi"
export INJECT_TARGET="operand"
export INCLUDE_CONSTANTS="0"
export INT_FLOAT_ONLY="1"
export RESULTS_SUBDIR="fi_inject_operand"
export WORKLIST="${PBS_O_WORKDIR:-$(pwd)}/HeCBench/results/llvm17_inject/jacobi/worklist_operand.csv"
export START_SITE="1"
export SKIP_EXISTING="1"
export COMPARE_MODE="float"

exec bash "${PBS_O_WORKDIR:-$(pwd)}/HeCBench/llvm17_inject_bench_sweep.pbs"
