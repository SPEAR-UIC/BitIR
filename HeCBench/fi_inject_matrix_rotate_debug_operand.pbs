#!/bin/bash
#PBS -A UIC-HPC
#PBS -N matrix_rotate_operand_debug
#PBS -q debug
#PBS -l select=1:ncpus=1:ngpus=1:mem=16gb
#PBS -l filesystems=home:eagle
#PBS -l walltime=01:00:00
#PBS -o OUT_matrix_rotate_operand_debug.out
#PBS -e ERROR_matrix_rotate_operand_debug.err

set -euo pipefail

export BENCH="matrix-rotate"
export INJECT_TARGET="operand"
export INCLUDE_CONSTANTS="0"
export INT_FLOAT_ONLY="1"
export RESULTS_SUBDIR="fi_inject_operand"
export WORKLIST="${PBS_O_WORKDIR:-$(pwd)}/HeCBench/results/llvm17_inject/matrix-rotate/worklist_operand.csv"
export START_SITE="1"
export SKIP_EXISTING="1"
export COMPARE_MODE="float"

if command -v nvidia-smi &> /dev/null; then
  (
    while true; do
      echo "[gpu-monitor] $(date +\"%Y-%m-%d %H:%M:%S\")"
      nvidia-smi --query-compute-apps=pid,process_name,gpu_uuid,used_gpu_memory --format=csv || true
      nvidia-smi --query-gpu=timestamp,uuid,utilization.gpu,utilization.memory,memory.used --format=csv || true
      nvidia-smi pmon -c 1 || true
      sleep 0.5
    done
  ) >> "OUT_matrix_rotate_operand_debug.out" &
  GPU_MONITOR_PID=$!
  trap 'kill ${GPU_MONITOR_PID} 2>/dev/null || true' EXIT
fi

exec bash "${PBS_O_WORKDIR:-$(pwd)}/HeCBench/llvm17_inject_bench_sweep.pbs"
