#!/bin/bash
#PBS -A UIC-HPC
#PBS -N layout_fi_operand_debug
#PBS -q debug
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l filesystems=home:eagle
#PBS -l walltime=01:00:00
#PBS -o OUT_layout_fi_operand_debug.out
#PBS -e ERROR_layout_fi_operand_debug.err

set -euo pipefail

export BENCH="layout"
export RESULTS_SUBDIR="llvm17_inject"
export RESULTS_DIR_OVERRIDE="${PBS_O_WORKDIR:-$(pwd)}/HeCBench/results/llvm17_inject/layout/operand"
export WORKLIST_PRUNED="${PBS_O_WORKDIR:-$(pwd)}/HeCBench/results/llvm17_inject/layout-sycl/worklist_operand_sycl_aligned.csv"
export INJECT_TARGET="operand"
export INCLUDE_CONSTANTS="0"
export INT_FLOAT_ONLY="1"
export COMPARE_MODE="exact"
export START_SITE="${START_SITE:-1}"
export SKIP_EXISTING="${SKIP_EXISTING:-1}"

exec bash "${PBS_O_WORKDIR:-$(pwd)}/HeCBench/llvm17_inject_bench_sweep.pbs"
