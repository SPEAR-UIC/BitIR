#!/bin/bash
#PBS -A UIC-HPC
#PBS -N fi_inject_jacobi
#PBS -q prod
#PBS -l select=24:ncpus=4:ngpus=4:mem=128gb
#PBS -l filesystems=home:eagle
#PBS -l walltime=03:00:00
#PBS -o OUT_jacobi_fi_inject.out
#PBS -e ERROR_jacobi_fi_inject.err
#PBS -M mdunl6@uic.edu
#PBS -m n

set -euo pipefail

export BENCH="jacobi"
export RESULTS_SUBDIR="llvm17_inject"
export RESULTS_DIR_OVERRIDE="${PBS_O_WORKDIR:-$(pwd)}/HeCBench/results/llvm17_inject/jacobi/float"
export WORKLIST_QUEUE="${WORKLIST_QUEUE:-1}"
export MISSING_ONLY=1
export SKIP_EXISTING=0
export CPU_PER_GPU="${CPU_PER_GPU:-1}"
export INJECT_TARGET="result"
export COMPARE_MODE="float"
exec bash "${PBS_O_WORKDIR:-$(pwd)}/HeCBench/llvm17_inject_bench_sweep.pbs"
