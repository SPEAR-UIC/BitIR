	cd /home/mdunlavy/GPU_FI/HeCBench/build-cuda118 && $(MAKE) $(MAKESILENT) -f src/mcmd-cuda/CMakeFiles/mcmd-cuda.dir/build.make src/mcmd-cuda/CMakeFiles/mcmd-cuda.dir/tt.cpp.s
.PHONY : tt.cpp.s

