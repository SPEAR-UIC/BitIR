#!/bin/bash
#PBS -A UIC-HPC
#PBS -N matrix_rotate_pointer_debug
#PBS -q debug
#PBS -l select=1:ncpus=32:ngpus=4:mem=64gb
#PBS -l filesystems=home:eagle
#PBS -l walltime=01:00:00
#PBS -o OUT_matrix_rotate_pointer_debug.out
#PBS -e ERROR_matrix_rotate_pointer_debug.err
#PBS -M mdunl6@uic.edu
#PBS -m abe

set -euo pipefail

export BENCH=matrix-rotate
export RESULTS_SUBDIR=llvm17_inject
export RESULTS_DIR_OVERRIDE=/home/mdunlavy/GPU_FI/HeCBench/results/llvm17_inject/matrix-rotate/pointer
export WORKLIST_PRUNED=/home/mdunlavy/GPU_FI/HeCBench/results/llvm17_inject/matrix-rotate-sycl/worklist_pointer_sycl_aligned.csv
export INJECT_TARGET=pointer
export INCLUDE_CONSTANTS=0
export INT_FLOAT_ONLY=1
export COMPARE_MODE=exact
export START_SITE=1
export SKIP_EXISTING=0

export CACHE_DEVICE_IR=1
export GENERATE_IR_LL=0
export MONITOR_GPU=0
export MONITOR_INTERVAL=300

exec bash /home/mdunlavy/GPU_FI/HeCBench/llvm17_inject_bench_sweep.pbs
