#!/bin/bash
#PBS -A UIC-HPC
#PBS -N fi_debug_finish_near_done
#PBS -q debug
#PBS -l select=1:ncpus=32:ngpus=4:mem=64gb
#PBS -l filesystems=home:eagle
#PBS -l walltime=01:00:00
#PBS -o OUT_finish_near_done_debug.out
#PBS -e ERROR_finish_near_done_debug.err
#PBS -M mdunl6@uic.edu
#PBS -m abe

set -euo pipefail

cd "${PBS_O_WORKDIR:-$(pwd)}"

export CACHE_DEVICE_IR="${CACHE_DEVICE_IR:-1}"
export GENERATE_IR_LL="${GENERATE_IR_LL:-0}"
export MONITOR_GPU="${MONITOR_GPU:-0}"
export MONITOR_INTERVAL="${MONITOR_INTERVAL:-300}"
export START_SITE=1
export SKIP_EXISTING=0

REPO_ROOT="${REPO_ROOT:-$PWD}"
RESULTS_ROOT="${REPO_ROOT}/HeCBench/results/llvm17_inject"

benchmarks=(matrix-rotate pathfinder layout)

echo "[debug] starting $(date)"
for bench in "${benchmarks[@]}"; do
  missing="${RESULTS_ROOT}/${bench}/worklist_missing.csv"
  if [[ ! -s "${missing}" ]]; then
    echo "[debug] ${bench}: no missing worklist or empty, skipping"
    continue
  fi
  echo "[debug] ${bench}: running missing-only worklist"
  BENCH="${bench}" \
  WORKLIST="${missing}" \
  COMPARE_MODE=exact \
  RESULTS_SUBDIR=llvm17_inject \
  bash "${REPO_ROOT}/HeCBench/llvm17_inject_bench_sweep.pbs"
done

echo "[debug] done $(date)"
