#!/bin/bash
#PBS -A UIC-HPC
#PBS -N colorwheel_fi_pointer
#PBS -q prod
#PBS -l select=50:ncpus=32:ngpus=4:mem=128gb
#PBS -l filesystems=home:eagle
#PBS -l walltime=06:00:00
#PBS -o OUT_colorwheel_fi_pointer.out
#PBS -e ERROR_colorwheel_fi_pointer.err
#PBS -M mdunl6@uic.edu
#PBS -m n

set -euo pipefail

export BENCH="colorwheel"
export RESULTS_SUBDIR="llvm17_inject"
export RESULTS_DIR_OVERRIDE="${PBS_O_WORKDIR:-$(pwd)}/HeCBench/results/llvm17_inject/colorwheel/pointer"
export INJECT_TARGET="pointer"
export INCLUDE_CONSTANTS="0"
export INT_FLOAT_ONLY="1"
export COMPARE_MODE="exact"
export START_SITE="${START_SITE:-1}"
export SKIP_EXISTING="${SKIP_EXISTING:-0}"
export CACHE_DEVICE_IR="${CACHE_DEVICE_IR:-1}"
export GENERATE_IR_LL="${GENERATE_IR_LL:-0}"
export MONITOR_GPU="${MONITOR_GPU:-0}"
export MONITOR_INTERVAL="${MONITOR_INTERVAL:-300}"
export WORKLIST_QUEUE="${WORKLIST_QUEUE:-1}"
export MISSING_ONLY=1

exec bash "${PBS_O_WORKDIR:-$(pwd)}/HeCBench/llvm17_inject_bench_sweep.pbs"
