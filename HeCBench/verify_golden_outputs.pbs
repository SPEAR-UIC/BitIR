#!/bin/bash
#PBS -A UIC-HPC
#PBS -N bitir_golden_verify
#PBS -q debug
#PBS -l select=1:ncpus=8:ngpus=1:mem=16gb
#PBS -l filesystems=home:eagle
#PBS -l walltime=01:00:00
#PBS -o OUT_verify.out
#PBS -e ERROR_verify.err

set -euo pipefail

JOB_WORKDIR="${PBS_O_WORKDIR:-${SLURM_SUBMIT_DIR:-$(pwd)}}"
BITIR_MACHINE="${BITIR_MACHINE:?BITIR_MACHINE is required}"

if command -v module &> /dev/null; then
  module purge
  for p in ${BITIR_MACHINE_MODULE_USE:-}; do
    module use "${p}" 2>/dev/null || true
  done
  for m in ${MODULE_LIST:-${BITIR_MACHINE_MODULES:-}}; do
    module load "$m" 2>/dev/null || true
  done
fi

cd "${JOB_WORKDIR}"

REPO_DIR="${JOB_WORKDIR}"
BUILD_DIR="${BUILD_DIR:-$REPO_DIR/${BITIR_MACHINE_BUILD_DIR:?BITIR_MACHINE_BUILD_DIR is required}}"
GOLDEN_DIR="${GOLDEN_DIR:-$REPO_DIR/${BITIR_MACHINE_GOLDEN_ROOT:?BITIR_MACHINE_GOLDEN_ROOT is required}}"
OUTPUT_ROOT="${OUTPUT_ROOT:-$REPO_DIR/${BITIR_MACHINE_MACHINE_LABEL:-Machine}_Verification_Outputs}"
RUNTIME_HOME="${BITIR_MACHINE_RUNTIME_HOME:-}"
RUNTIME_HOME_FALLBACKS="${BITIR_MACHINE_RUNTIME_HOME_FALLBACKS:-}"
RUNTIME_BIN_DIRS="${BITIR_MACHINE_RUNTIME_BIN_DIRS:-bin}"
RUNTIME_LIB_DIRS="${BITIR_MACHINE_RUNTIME_LIB_DIRS:-lib64 lib64/stubs}"
COMPILER_DRIVER="${BITIR_MACHINE_COMPILER_DRIVER:?BITIR_MACHINE_COMPILER_DRIVER is required}"
DEVICE_BIN_SUBDIR="${BITIR_MACHINE_BINARY_SUBDIR:?BITIR_MACHINE_BINARY_SUBDIR is required}"
ABS_TOL="${ABS_TOL:?ABS_TOL is required}"
REL_TOL="${REL_TOL:?REL_TOL is required}"
mkdir -p "${OUTPUT_ROOT}"

timestamp() {
  date +"%Y-%m-%d %H:%M:%S"
}

SUMMARY_FILE="${OUTPUT_ROOT}/verify_summary.txt"
{
  echo "${BITIR_MACHINE_MACHINE_LABEL:-Machine} golden verification run"
  echo "Repository   : ${REPO_DIR}"
  echo "Build dir    : ${BUILD_DIR}"
  echo "Golden dir   : ${GOLDEN_DIR}"
  echo "Output dir   : ${OUTPUT_ROOT}"
  echo "Start time   : $(timestamp)"
} > "${SUMMARY_FILE}"

append_summary() {
  echo "[$(timestamp)] $1" >> "${SUMMARY_FILE}"
}

if [[ -z "${CUDA_HOME:-}" ]]; then
  if [[ -n "${RUNTIME_HOME}" && -d "${RUNTIME_HOME}" ]]; then
    CUDA_HOME="${RUNTIME_HOME}"
  elif command -v "${COMPILER_DRIVER}" &> /dev/null; then
    CUDA_HOME="$(dirname "$(dirname "$(command -v "${COMPILER_DRIVER}")")")"
  elif [[ -n "${CUDATOOLKIT_ROOT:-}" ]]; then
    CUDA_HOME="${CUDATOOLKIT_ROOT}"
  else
    for candidate in ${RUNTIME_HOME_FALLBACKS}; do
      if [[ -d "${candidate}" ]]; then
        CUDA_HOME="${candidate}"
        break
      fi
    done
  fi
fi
if [[ -n "${CUDA_HOME:-}" ]]; then
  for rel in ${RUNTIME_BIN_DIRS}; do
    candidate="${CUDA_HOME}/${rel}"
    [[ -d "${candidate}" ]] && PATH="${candidate}:${PATH:-}"
  done
  for rel in ${RUNTIME_LIB_DIRS}; do
    candidate="${CUDA_HOME}/${rel}"
    [[ -d "${candidate}" ]] && LD_LIBRARY_PATH="${candidate}:${LD_LIBRARY_PATH:-}"
  done
  export PATH LD_LIBRARY_PATH
  append_summary "Runtime home: ${CUDA_HOME}"
fi

ensure_binary() {
  local name="$1"
  local path="$2"
  if [[ ! -x "${path}" ]]; then
    echo "Missing binary for ${name}: ${path}"
    exit 1
  fi
}

run_benchmark() {
  local name="$1"
  local bin="$2"
  shift 2
  local log="${OUTPUT_ROOT}/${name}.log"
  local err="${OUTPUT_ROOT}/${name}.err"
  rm -f "${log}" "${err}"
  ensure_binary "${name}" "${bin}"
  echo "[$(timestamp)] Running ${name}: ${bin} $*" | tee "${log}"
  set +e
  "${bin}" "$@" > >(tee -a "${log}") 2> >(tee -a "${err}" >&2)
  local status=$?
  set -e
  if [[ $status -ne 0 ]]; then
    append_summary "${name}: FAILED during execution"
    exit "${status}"
  fi
  [[ ! -s "${err}" ]] && rm -f "${err}"
  append_summary "${name}: log=$(basename "${log}")"
}

compare_exact() {
  if ! cmp -s "$2" "$1"; then
    echo "Mismatch detected for $3: $1 vs $2"
    append_summary "$3: MISMATCH"
    exit 3
  fi
}

compare_matrix() {
  if ! python3 "${REPO_DIR}/HeCBench/tools/llvm17_inject/compare_matrix_dump.py" \
      "$1" "$2" --abs-tol "${ABS_TOL}" --rel-tol "${REL_TOL}" >/dev/null; then
    echo "Mismatch detected for $3: $2 vs $1"
    append_summary "$3: MISMATCH"
    exit 3
  fi
}

if [[ -n "${BENCH_ONLY_FILE:-}" && -f "${BENCH_ONLY_FILE}" ]]; then
  mapfile -t BENCH_LIST < "${BENCH_ONLY_FILE}"
elif [[ -n "${BENCH_ONLY:-}" ]]; then
  BENCH_ONLY_NORM="${BENCH_ONLY//,/ }"
  read -r -a BENCH_LIST <<< "${BENCH_ONLY_NORM}"
else
  read -r -a BENCH_LIST <<< "${BITIR_BENCHMARKS:-}"
fi

for bench in "${BENCH_LIST[@]}"; do
  dump="${OUTPUT_ROOT}/${BITIR_GOLDEN_FILE:-${bench}.bin}"
  bin="${BUILD_DIR}/bin/${DEVICE_BIN_SUBDIR}/${bench}"
  bench_args=()
  if [[ -n "${BITIR_RUN_ARGS:-}" ]]; then
    read -r -a bench_args <<< "${BITIR_RUN_ARGS}"
  fi
  rm -f "${dump}"
  run_benchmark "${bench}" "${bin}" "${bench_args[@]}" "${dump}"
  if [[ "${BITIR_COMPARE_MODE:-exact}" == "float" ]]; then
    compare_matrix "${GOLDEN_DIR}/${BITIR_GOLDEN_FILE:-${bench}.bin}" "${dump}" "${bench}"
  else
    compare_exact "${dump}" "${GOLDEN_DIR}/${BITIR_GOLDEN_FILE:-${bench}.bin}" "${bench}"
  fi
  append_summary "${bench}: matches golden output"
done

append_summary "All verification comparisons matched their golden references."
echo "Verification outputs stored under ${OUTPUT_ROOT}"
