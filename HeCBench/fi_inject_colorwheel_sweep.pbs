#!/bin/bash
#PBS -A UIC-HPC
#PBS -N colorwheel_fi_inject
#PBS -q prod
#PBS -l select=50:ncpus=32:ngpus=4:mem=128gb
#PBS -l filesystems=home:eagle
#PBS -l walltime=06:00:00
#PBS -o OUT_colorwheel_fi_inject.out
#PBS -e ERROR_colorwheel_fi_inject.err
#PBS -M mdunl6@uic.edu
#PBS -m n

set -euo pipefail

export BENCH="colorwheel"
export RESULTS_SUBDIR="llvm17_inject"
export RESULTS_DIR_OVERRIDE="${PBS_O_WORKDIR:-$(pwd)}/HeCBench/results/llvm17_inject/colorwheel/float"
export WORKLIST_QUEUE="${WORKLIST_QUEUE:-1}"
export MISSING_ONLY=1
export SKIP_EXISTING=0
export INJECT_TARGET="result"
export COMPARE_MODE="exact"
exec bash "${PBS_O_WORKDIR:-$(pwd)}/HeCBench/llvm17_inject_bench_sweep.pbs"
