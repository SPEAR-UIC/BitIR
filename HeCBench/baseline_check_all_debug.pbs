#!/bin/bash
#PBS -A UIC-HPC
#PBS -N baseline_check_all
#PBS -q debug
#PBS -l select=1:ncpus=32:ngpus=1:mem=64gb
#PBS -l filesystems=home:eagle
#PBS -l walltime=01:00:00
#PBS -o OUT_baseline_check_all.out
#PBS -e ERROR_baseline_check_all.err

set -euo pipefail

if command -v module &> /dev/null; then
  module use /soft/modulefiles
  module purge
  module load spack-pe-base cmake
  module load cudatoolkit-standalone/11.8.0
fi

cd "$PBS_O_WORKDIR"

REPO_ROOT="${REPO_ROOT:-$PBS_O_WORKDIR}"
export CUDA_HOME="${CUDA_HOME:-/soft/compilers/cudatoolkit/cuda-11.8.0}"
export PATH="${CUDA_HOME}/bin:${PATH:-}"
export LD_LIBRARY_PATH="${CUDA_HOME}/lib64:${LD_LIBRARY_PATH:-}"
export CUDA_DEVICE_ORDER="${CUDA_DEVICE_ORDER:-PCI_BUS_ID}"
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"

BIN_ROOT="${BIN_ROOT:-${REPO_ROOT}/HeCBench/build-cuda118/bin/cuda}"
if [[ ! -d "${BIN_ROOT}" ]]; then
  BIN_ROOT="${REPO_ROOT}/build/bin/cuda"
fi

OUT_ROOT="${REPO_ROOT}/HeCBench/results/baseline_checks"
mkdir -p "${OUT_ROOT}"

echo "[env] BIN_ROOT=${BIN_ROOT}"
echo "[env] CUDA_HOME=${CUDA_HOME}"
echo "[env] start=$(date)"

compare_exact() {
  local golden="$1"
  local candidate="$2"
  python3 "${REPO_ROOT}/HeCBench/tools/llvm17_inject/compare_binary_exact.py" \
    "${golden}" "${candidate}"
}

compare_matrix() {
  local golden="$1"
  local candidate="$2"
  python3 "${REPO_ROOT}/HeCBench/tools/llvm17_inject/compare_matrix_dump.py" \
    "${golden}" "${candidate}" --abs-tol 1e-5 --rel-tol 1e-6
}

run_baseline() {
  local bench="$1"
  local bin="$2"
  shift 2
  local args=("$@")
  local outdir="${OUT_ROOT}/${bench}"
  mkdir -p "${outdir}"
  local dump="${outdir}/baseline_${bench}.bin"
  local out="${outdir}/baseline_${bench}.out"
  local err="${outdir}/baseline_${bench}.err"
  local cmp="${outdir}/baseline_${bench}.cmp"
  rm -f "${dump}"
  echo "[baseline] ${bench} -> ${dump}"
  CUDA_VISIBLE_DEVICES=0 HECBENCH_LLFI_FORCE_DUMP=1 \
    "${bin}" "${args[@]}" "${dump}" >"${out}" 2>"${err}" || true
  echo "[compare] ${bench}" >> "${cmp}"
  if [[ "${bench}" == "matrix-rotate" ]]; then
    compare_matrix "${REPO_ROOT}/Polaris_Golden_Outputs/matrix-rotate_8192_10.bin" "${dump}" >> "${cmp}" 2>&1 || true
  else
    compare_exact "${REPO_ROOT}/Polaris_Golden_Outputs/${bench}.bin" "${dump}" >> "${cmp}" 2>&1 || true
  fi
}

# matrix-rotate
run_baseline "matrix-rotate" "${BIN_ROOT}/matrix-rotate" 8192 10
# jacobi
run_baseline "jacobi" "${BIN_ROOT}/jacobi"
# layout
run_baseline "layout" "${BIN_ROOT}/layout" 20
# atomicCost
run_baseline "atomicCost" "${BIN_ROOT}/atomicCost" 16 5
# dense-embedding
run_baseline "dense-embedding" "${BIN_ROOT}/dense-embedding" 5000 64 5
# pathfinder
run_baseline "pathfinder" "${BIN_ROOT}/pathfinder" 1000 1000 100
# bsearch
run_baseline "bsearch" "${BIN_ROOT}/bsearch" 16777216 10
# entropy
run_baseline "entropy" "${BIN_ROOT}/entropy" 4096 4096 5
# colorwheel
run_baseline "colorwheel" "${BIN_ROOT}/colorwheel" 1.0 4096 5
# randomAccess
run_baseline "randomAccess" "${BIN_ROOT}/randomAccess" 3

echo "[env] end=$(date)"
