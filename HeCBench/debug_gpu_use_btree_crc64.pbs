#!/bin/bash
#PBS -A UIC-HPC
#PBS -N gpu_use_btree_crc64
#PBS -q debug
#PBS -l select=1:ncpus=32:ngpus=4:mem=128gb
#PBS -l filesystems=home:eagle
#PBS -l walltime=00:30:00
#PBS -o OUT_gpu_use_btree_crc64.out
#PBS -e ERROR_gpu_use_btree_crc64.err

set -euo pipefail

if command -v module >/dev/null 2>&1; then
  module use /soft/modulefiles
  module purge
  module load spack-pe-base
  module load cudatoolkit-standalone/11.8.0
fi

cd "$PBS_O_WORKDIR"

export CUDA_HOME="${CUDA_HOME:-/soft/compilers/cudatoolkit/cuda-11.8.0}"
export PATH="${CUDA_HOME}/bin:${PATH:-}"
export LD_LIBRARY_PATH="${CUDA_HOME}/lib64:${LD_LIBRARY_PATH:-}"
export CUDA_DEVICE_ORDER=PCI_BUS_ID
BTREE_NUM_KEYS="${BTREE_NUM_KEYS:-8192}"
BTREE_NUM_QUERIES="${BTREE_NUM_QUERIES:-8192}"
BTREE_SEED="${BTREE_SEED:-12345}"
CRC64_NTESTS="${CRC64_NTESTS:-200}"
CRC64_SEED="${CRC64_SEED:-5}"
CRC64_MAX_LEN="${CRC64_MAX_LEN:-65536}"

LOG_DIR="${PBS_O_WORKDIR}/HeCBench/results/debug_gpu_checks/btree_crc64_${PBS_JOBID%%.*}"
mkdir -p "${LOG_DIR}"

echo "[job] host=$(hostname) jobid=${PBS_JOBID} start=$(date)"
echo "[job] CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-<unset>}"
echo "[job] BTREE_NUM_KEYS=${BTREE_NUM_KEYS} BTREE_NUM_QUERIES=${BTREE_NUM_QUERIES}"
echo "[job] BTREE_SEED=${BTREE_SEED}"
echo "[job] CRC64_NTESTS=${CRC64_NTESTS} CRC64_SEED=${CRC64_SEED} CRC64_MAX_LEN=${CRC64_MAX_LEN}"

nvidia-smi -L | tee "${LOG_DIR}/nvidia_smi_L.txt"
nvidia-smi --query-gpu=index,name,uuid,utilization.gpu,memory.used,memory.total --format=csv,noheader | tee "${LOG_DIR}/nvidia_smi_start.csv"

run_bench() {
  local name="$1"
  shift
  local run_log="${LOG_DIR}/${name}.out"
  local pmon_log="${LOG_DIR}/${name}.pmon"
  local rc=0
  local util_seen=0

  echo "[run] ${name} start $(date)"
  nvidia-smi pmon -s um -d 1 -c 120 > "${pmon_log}" 2>&1 &
  local mon_pid=$!

  set +e
  { time "$@"; } > "${run_log}" 2>&1
  rc=$?
  set -e

  kill "${mon_pid}" >/dev/null 2>&1 || true
  wait "${mon_pid}" 2>/dev/null || true

  if awk '($1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ && (($4+0)>0 || ($5+0)>0)) {seen=1} END{exit seen?0:1}' "${pmon_log}"; then
    util_seen=1
  fi

  echo "[run] ${name} rc=${rc} gpu_util_seen=${util_seen}"
  if [[ ${rc} -ne 0 ]]; then
    echo "[run] ${name} failed (non-zero exit)."
    return 1
  fi
  if [[ ${util_seen} -ne 1 ]]; then
    echo "[run] ${name} did not show non-zero GPU util in pmon."
    return 2
  fi
  return 0
}

overall=0

run_bench "btree" \
  "${PBS_O_WORKDIR}/HeCBench/build/llvm17-inject-validation-btree/btree" \
  "${BTREE_NUM_KEYS}" "${BTREE_NUM_QUERIES}" "${BTREE_SEED}" || overall=1

run_bench "crc64" \
  "${PBS_O_WORKDIR}/HeCBench/build/llvm17-inject-validation-crc64/crc64" \
  "${CRC64_NTESTS}" "${CRC64_SEED}" "${CRC64_MAX_LEN}" || overall=1

nvidia-smi --query-gpu=index,name,uuid,utilization.gpu,memory.used,memory.total --format=csv,noheader | tee "${LOG_DIR}/nvidia_smi_end.csv"

echo "[job] logs=${LOG_DIR}"
echo "[job] done $(date) overall=${overall}"
exit ${overall}
