#!/bin/bash
#PBS -A UIC-HPC
#PBS -N llfi_inject_matrix_rotate
#PBS -q debug
#PBS -l select=1:ncpus=1:ngpus=1:mem=32gb
#PBS -l filesystems=home:eagle
#PBS -l walltime=00:05:00
#PBS -o OUT_llfi_inject_matrix_rotate.out
#PBS -e ERROR_llfi_inject_test.err

set -euo pipefail

if command -v module &> /dev/null; then
  module use /soft/modulefiles
  module purge
  module load spack-pe-base cmake
  if [[ -n "${PYTHON_MODULE:-}" ]]; then
    module load "${PYTHON_MODULE}"
  fi
  module load llvm/release-17.0.0 || true
fi

REPO_ROOT="${PBS_O_WORKDIR:-$PWD}"
if [[ -d "${REPO_ROOT}/tools/llvm17_inject" && ! -d "${REPO_ROOT}/HeCBench/tools/llvm17_inject" ]]; then
  REPO_ROOT="$(dirname "${REPO_ROOT}")"
fi
cd "$REPO_ROOT"

export CUDA_HOME="${CUDA_HOME:-/soft/compilers/cudatoolkit/cuda-11.8.0}"
export CUDA_ARCH="${CUDA_ARCH:-sm_80}"

export SITE_ID="${SITE_ID:-1}"
export BIT_INDEX="${BIT_INDEX:-0}"
export MATRIX_SIZE="${MATRIX_SIZE:-8192}"
export MATRIX_REPEAT="${MATRIX_REPEAT:-10}"

if command -v nvidia-smi &> /dev/null; then
  nvidia-smi -L || true
  echo "CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-}"
  nvidia-smi --query-compute-apps=pid,process_name,gpu_uuid --format=csv || true
  nvidia-smi pmon -c 1 || true
fi

bash HeCBench/tools/llvm17_inject/build.sh

SITE_ID="${SITE_ID}" BIT_INDEX="${BIT_INDEX}" \
  MATRIX_SIZE="${MATRIX_SIZE}" MATRIX_REPEAT="${MATRIX_REPEAT}" \
  bash HeCBench/tools/llvm17_inject/run_matrix_rotate_injection.sh

if command -v nvidia-smi &> /dev/null; then
  nvidia-smi --query-compute-apps=pid,process_name,gpu_uuid --format=csv || true
  nvidia-smi pmon -c 1 || true
fi
