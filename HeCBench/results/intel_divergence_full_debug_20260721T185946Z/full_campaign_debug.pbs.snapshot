#!/bin/bash
#PBS -N intel_div_rerun
#PBS -A UIC-HPC
#PBS -q debug
#PBS -l select=1:ncpus=12:ngpus=1:mem=32gb
#PBS -l filesystems=home
#PBS -l walltime=01:00:00
#PBS -j oe

set -euo pipefail

if ! command -v module >/dev/null 2>&1 && [[ -f /etc/profile.d/modules.sh ]]; then
  source /etc/profile.d/modules.sh
fi

if command -v module >/dev/null 2>&1; then
  module purge || true
  module use /opt/aurora/25.190.0/spack/unified/0.10.1/install/modulefiles/Core 2>/dev/null || true
  module use /opt/aurora/25.190.0/modulefiles 2>/dev/null || true
  module load cmake/3.31.8 2>/dev/null || true
  module load ninja/1.12.1 2>/dev/null || true
  module load oneapi/release/2025.2.0 2>/dev/null || true
fi

REPO_ROOT="${PBS_O_WORKDIR:-$HOME/GPU_FI}"
RESULTS_DIR="/home/mdunlavy/GPU_FI/HeCBench/results/intel_divergence_full_debug_20260721T185946Z"
export SKIP_GOLDEN_GEN=1
export TRACE_LEVEL=basic

mkdir -p "${RESULTS_DIR}"
exec > >(tee -a "${RESULTS_DIR}/pbs_stdout.log") 2>&1

cat <<INFO > "${RESULTS_DIR}/job_context.txt"
repo_root=${REPO_ROOT}
results_dir=${RESULTS_DIR}
job_id=${PBS_JOBID:-}
queue=debug
walltime=01:00:00
commit=7e62ea8f41bebec4c7cbb047bc23f92c7a9fa662
INFO

cat <<'STATUS' > "${RESULTS_DIR}/git_status_at_submit.txt"
## divergence_cases...origin/divergence_cases [ahead 3]
 M HeCBench/config/bitir.yml
 M HeCBench/tools/llvm17_inject/run_intel_divergence_rerun_campaign.sh
?? intel_basechk.o8680377
?? intel_div_rerun.o8679708
?? intel_div_rerun.o8679777
?? intel_div_rerun.o8679778
?? intel_div_rerun.o8679864
?? intel_div_rerun.o8679912
STATUS

cp -f "${REPO_ROOT}/HeCBench/intel_divergence_rerun_campaign.pbs" "${RESULTS_DIR}/submitted_job.pbs"
cp -f "${REPO_ROOT}/HeCBench/config/bitir.yml" "${RESULTS_DIR}/bitir.yml"
cp -f "${REPO_ROOT}/HeCBench/tools/llvm17_inject/run_intel_divergence_rerun_campaign.sh" "${RESULTS_DIR}/run_intel_divergence_rerun_campaign.sh"
cp -f "${REPO_ROOT}/HeCBench/tools/llvm17_inject/run_benchmark_injection.sh" "${RESULTS_DIR}/run_benchmark_injection.sh"
cp -f "${REPO_ROOT}/HeCBench/tools/llvm17_inject/compare_binary_u8_tolerance.py" "${RESULTS_DIR}/compare_binary_u8_tolerance.py" 2>/dev/null || true
cp -f "/home/mdunlavy/GPU_FI/HeCBench/results/intel_divergence_full_debug_20260721T185946Z/full_campaign_debug.pbs" "${RESULTS_DIR}/full_campaign_debug.pbs.snapshot"

{
  echo "[pbs] start $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "[pbs] host $(hostname)"
  echo "[pbs] repo_root=${REPO_ROOT}"
  echo "[pbs] results_dir=${RESULTS_DIR}"
  echo "[pbs] job_id=${PBS_JOBID:-}"
} | tee "${RESULTS_DIR}/pbs_environment.log"

cd "${REPO_ROOT}"

RESULTS_DIR="${RESULTS_DIR}" REPO_ROOT="${REPO_ROOT}" bash "${REPO_ROOT}/HeCBench/tools/llvm17_inject/run_intel_divergence_rerun_campaign.sh"
