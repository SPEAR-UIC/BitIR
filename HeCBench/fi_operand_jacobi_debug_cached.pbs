#!/bin/bash
#PBS -A UIC-HPC
#PBS -N jacobi_operand_debug
#PBS -q debug
#PBS -l select=1:ncpus=32:ngpus=4:mem=64gb
#PBS -l filesystems=home:eagle
#PBS -l walltime=01:00:00
#PBS -o OUT_jacobi_operand_debug.out
#PBS -e ERROR_jacobi_operand_debug.err
#PBS -M mdunl6@uic.edu
#PBS -m abe

set -euo pipefail

export BENCH="jacobi"
export RESULTS_SUBDIR="fi_inject_operand"
export WORKLIST_PRUNED="${PBS_O_WORKDIR:-$(pwd)}/HeCBench/results/fi_inject_operand/jacobi/worklist_missing.csv"
export INJECT_TARGET="operand"
export INCLUDE_CONSTANTS="0"
export INT_FLOAT_ONLY="1"
export COMPARE_MODE="exact"
export START_SITE=1
export SKIP_EXISTING=0

export CACHE_DEVICE_IR="${CACHE_DEVICE_IR:-1}"
export GENERATE_IR_LL="${GENERATE_IR_LL:-0}"
export MONITOR_GPU="${MONITOR_GPU:-0}"
export MONITOR_INTERVAL="${MONITOR_INTERVAL:-300}"

exec bash "${PBS_O_WORKDIR:-$(pwd)}/HeCBench/llvm17_inject_bench_sweep.pbs"
