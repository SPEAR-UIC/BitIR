#!/bin/bash
#PBS -A UIC-HPC
#PBS -N matrix_rotate_fi_operand
#PBS -q large
#PBS -l select=100:ncpus=1:ngpus=4:mem=32gb
#PBS -l filesystems=home:eagle
#PBS -l walltime=10:00:00
#PBS -o OUT_matrix_rotate_fi_operand.out
#PBS -e ERROR_matrix_rotate_fi_operand.err

set -euo pipefail

export BENCH="matrix-rotate"
export RESULTS_SUBDIR="fi_inject_operand"
export WORKLIST="${PBS_O_WORKDIR:-$(pwd)}/HeCBench/results/llvm17_inject/matrix-rotate/worklist_operand.csv"
export INJECT_TARGET="operand"
export INCLUDE_CONSTANTS="0"
export INT_FLOAT_ONLY="1"
export COMPARE_MODE="exact"
export START_SITE="${START_SITE:-1}"
export SKIP_EXISTING="${SKIP_EXISTING:-1}"

exec bash "${PBS_O_WORKDIR:-$(pwd)}/HeCBench/llvm17_inject_bench_sweep.pbs"
