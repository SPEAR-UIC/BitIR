#!/bin/bash
#PBS -A UIC-HPC
#PBS -N validate_bt_crc64
#PBS -q debug
#PBS -l select=1:ncpus=32:ngpus=4:mem=128gb
#PBS -l filesystems=home:eagle
#PBS -l walltime=00:10:00
#PBS -o OUT_validate_bt_crc64.out
#PBS -e ERROR_validate_bt_crc64.err

set -euo pipefail

if command -v module >/dev/null 2>&1; then
  module use /soft/modulefiles
  module purge
  module load spack-pe-base
  module load cudatoolkit-standalone/11.8.0
  module load llvm/release-17.0.0
fi

cd "$PBS_O_WORKDIR"

export CUDA_HOME="${CUDA_HOME:-/soft/compilers/cudatoolkit/cuda-11.8.0}"
export PATH="${CUDA_HOME}/bin:${PATH:-}"
export LD_LIBRARY_PATH="${CUDA_HOME}/lib64:${LD_LIBRARY_PATH:-}"
export CUDA_DEVICE_ORDER=PCI_BUS_ID
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"

# CRC64 debug validation defaults (btree disabled until replacement is selected).
export BTREE_NUM_KEYS="${BTREE_NUM_KEYS:-8192}"
export BTREE_NUM_QUERIES="${BTREE_NUM_QUERIES:-8192}"
export BTREE_SEED="${BTREE_SEED:-12345}"
export CRC64_NTESTS="${CRC64_NTESTS:-200}"
export CRC64_SEED="${CRC64_SEED:-5}"
export CRC64_MAX_LEN="${CRC64_MAX_LEN:-65536}"
export ENABLE_BTREE="${ENABLE_BTREE:-0}"
export SMOKE_COUNT="${SMOKE_COUNT:-3}"
export HEARTBEAT_SEC="${HEARTBEAT_SEC:-20}"
export STAGE_TIMEOUT_SEC="${STAGE_TIMEOUT_SEC:-600}"

echo "[job] host=$(hostname) start=$(date)"
echo "[job] params: ENABLE_BTREE=${ENABLE_BTREE}"
echo "[job] params: BTREE_NUM_KEYS=${BTREE_NUM_KEYS} BTREE_NUM_QUERIES=${BTREE_NUM_QUERIES} BTREE_SEED=${BTREE_SEED}"
echo "[job] params: CRC64_NTESTS=${CRC64_NTESTS} CRC64_SEED=${CRC64_SEED} CRC64_MAX_LEN=${CRC64_MAX_LEN}"
echo "[job] params: HEARTBEAT_SEC=${HEARTBEAT_SEC} STAGE_TIMEOUT_SEC=${STAGE_TIMEOUT_SEC}"

bash "${PBS_O_WORKDIR}/HeCBench/tools/llvm17_inject/golden_baseline_smoke_text.sh"

echo "[job] done $(date)"
