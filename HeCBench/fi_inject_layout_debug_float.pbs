#!/bin/bash
#PBS -A UIC-HPC
#PBS -N layout_float_debug
#PBS -q debug
#PBS -l select=1:ncpus=1:ngpus=1:mem=16gb
#PBS -l filesystems=home:eagle
#PBS -l walltime=01:00:00
#PBS -o OUT_layout_float_debug.out
#PBS -e ERROR_layout_float_debug.err

set -euo pipefail

export BENCH="layout"
export INJECT_TARGET="result"
export INCLUDE_CONSTANTS="0"
export INT_FLOAT_ONLY="1"
export START_SITE="1"
export SKIP_EXISTING="0"
export COMPARE_MODE="exact"

exec bash "${PBS_O_WORKDIR:-$(pwd)}/HeCBench/llvm17_inject_bench_sweep.pbs"
