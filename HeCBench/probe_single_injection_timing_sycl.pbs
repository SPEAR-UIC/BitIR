#!/bin/bash
#PBS -A UIC-HPC
#PBS -N probe_single_injection_timing_sycl
#PBS -q debug
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l filesystems=home
#PBS -l walltime=01:00:00
#PBS -o OUT_probe_single_injection_timing_sycl.out
#PBS -e ERROR_probe_single_injection_timing_sycl.err

set -euo pipefail

REPO_ROOT="${REPO_ROOT:-/home/mdunlavy/GPU_FI}"

if ! command -v module &>/dev/null && [[ -f /etc/profile.d/modules.sh ]]; then
  # shellcheck disable=SC1091
  source /etc/profile.d/modules.sh
fi

if command -v module &>/dev/null; then
  module purge || true
  module use /opt/aurora/25.190.0/spack/unified/0.10.1/install/modulefiles/Core 2>/dev/null || true
  module use /opt/aurora/25.190.0/modulefiles 2>/dev/null || true
  module load oneapi/release/2025.2.0 2>/dev/null || \
  module load oneapi/release/2025.0.5 2>/dev/null || \
  module load oneapi/release/2024.2.1 2>/dev/null || \
  module load oneapi/eng-compiler/2024.07.30.002 2>/dev/null || true
fi

cd "${REPO_ROOT}"

BENCH="${BENCH:-matrix-rotate}"
SITE_ID="${SITE_ID:-6}"
BIT_INDEX="${BIT_INDEX:-8}"
INJECT_TARGET="${INJECT_TARGET:-all}"
INPUT_PROFILE="${INPUT_PROFILE:-small}"
GPU_ID="${GPU_ID:-0}"

RESULTS_ROOT="${REPO_ROOT}/HeCBench/results/llvm17_probe/${BENCH}-sycl"
PROBE_TAG="${PBS_JOBID//[^A-Za-z0-9._-]/_}"
CACHED_CACHE_DIR="${REPO_ROOT}/HeCBench/build/probe-${BENCH}-sycl-${PROBE_TAG}/cached-cache"
CACHED_COLD_OUT_DIR="${REPO_ROOT}/HeCBench/build/probe-${BENCH}-sycl-${PROBE_TAG}/cached-cold-run"
CACHED_WARM_OUT_DIR="${REPO_ROOT}/HeCBench/build/probe-${BENCH}-sycl-${PROBE_TAG}/cached-warm-run"
FULL1_OUT_DIR="${REPO_ROOT}/HeCBench/build/probe-${BENCH}-sycl-${PROBE_TAG}/full1-run"
FULL2_OUT_DIR="${REPO_ROOT}/HeCBench/build/probe-${BENCH}-sycl-${PROBE_TAG}/full2-run"
SUMMARY_LOG="${RESULTS_ROOT}/probe_${PROBE_TAG}.log"
CACHED_COLD_STDOUT="${RESULTS_ROOT}/cached_cold_site${SITE_ID}_bit${BIT_INDEX}.out"
CACHED_COLD_STDERR="${RESULTS_ROOT}/cached_cold_site${SITE_ID}_bit${BIT_INDEX}.err"
CACHED_WARM_STDOUT="${RESULTS_ROOT}/cached_warm_site${SITE_ID}_bit${BIT_INDEX}.out"
CACHED_WARM_STDERR="${RESULTS_ROOT}/cached_warm_site${SITE_ID}_bit${BIT_INDEX}.err"
FULL1_STDOUT="${RESULTS_ROOT}/full_rebuild_1_site${SITE_ID}_bit${BIT_INDEX}.out"
FULL1_STDERR="${RESULTS_ROOT}/full_rebuild_1_site${SITE_ID}_bit${BIT_INDEX}.err"
FULL2_STDOUT="${RESULTS_ROOT}/full_rebuild_2_site${SITE_ID}_bit${BIT_INDEX}.out"
FULL2_STDERR="${RESULTS_ROOT}/full_rebuild_2_site${SITE_ID}_bit${BIT_INDEX}.err"

mkdir -p "${RESULTS_ROOT}" "${CACHED_COLD_OUT_DIR}" "${CACHED_WARM_OUT_DIR}" "${FULL1_OUT_DIR}" "${FULL2_OUT_DIR}" "${CACHED_CACHE_DIR}"

export SYCL_DEVICE_FILTER="level_zero:gpu"
export ONEAPI_DEVICE_SELECTOR="level_zero:gpu"
export ZE_AFFINITY_MASK="${GPU_ID}"
export HECBENCH_GPU_DEBUG=1
export HECBENCH_TIMING_DEBUG=1
export SKIP_EXISTING=0
export INPUT_PROFILE

run_probe() {
  local label="$1"
  local cache_dir="$2"
  local out_dir="$3"
  local run_out="$4"
  local run_err="$5"
  local full_rebuild="$6"
  local total_start total_end rc

  total_start="$(date +%s)"
  set +e
  CACHE_DIR="${cache_dir}" \
  OUT_DIR="${out_dir}" \
  RESULTS_DIR="${RESULTS_ROOT}" \
  RUN_OUT="${run_out}" \
  RUN_ERR="${run_err}" \
  FULL_REBUILD="${full_rebuild}" \
  BENCH="${BENCH}" \
  SITE_ID="${SITE_ID}" \
  BIT_INDEX="${BIT_INDEX}" \
  INJECT_TARGET="${INJECT_TARGET}" \
  REPO_ROOT="${REPO_ROOT}" \
  bash "${REPO_ROOT}/HeCBench/tools/llvm17_inject/run_benchmark_injection_sycl.sh"
  rc=$?
  set -e
  total_end="$(date +%s)"

  {
    echo "[probe] label=${label} full_rebuild=${full_rebuild} rc=${rc} total_seconds=$((total_end - total_start))"
    echo "[probe] cache_dir=${cache_dir}"
    echo "[probe] out_dir=${out_dir}"
    echo "[probe] stdout=${run_out}"
    echo "[probe] stderr=${run_err}"
  } | tee -a "${SUMMARY_LOG}"

  return "${rc}"
}

{
  echo "[probe] start $(date -u +%F_%T)"
  echo "[probe] host=$(hostname)"
  echo "[probe] bench=${BENCH} site=${SITE_ID} bit=${BIT_INDEX} target=${INJECT_TARGET}"
  echo "[probe] gpu_id=${GPU_ID}"
  echo "[probe] cached_cache=${CACHED_CACHE_DIR}"
} > "${SUMMARY_LOG}"

run_probe cached_cold "${CACHED_CACHE_DIR}" "${CACHED_COLD_OUT_DIR}" "${CACHED_COLD_STDOUT}" "${CACHED_COLD_STDERR}" 0
run_probe cached_warm "${CACHED_CACHE_DIR}" "${CACHED_WARM_OUT_DIR}" "${CACHED_WARM_STDOUT}" "${CACHED_WARM_STDERR}" 0
run_probe full_rebuild_1 "${FULL1_OUT_DIR}/cache" "${FULL1_OUT_DIR}" "${FULL1_STDOUT}" "${FULL1_STDERR}" 1
run_probe full_rebuild_2 "${FULL2_OUT_DIR}/cache" "${FULL2_OUT_DIR}" "${FULL2_STDOUT}" "${FULL2_STDERR}" 1

echo "[probe] end $(date -u +%F_%T)" | tee -a "${SUMMARY_LOG}"
