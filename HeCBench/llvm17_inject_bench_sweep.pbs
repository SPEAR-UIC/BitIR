#!/usr/bin/env bash
set -euo pipefail

need() {
  local name="$1"
  if [[ -z "${!name:-}" ]]; then
    echo "missing required setting: ${name}" >&2
    exit 1
  fi
}

worklist_suffix() {
  case "${INJECT_TARGET}" in
    operand) printf '%s\n' "_operand" ;;
    pointer) printf '%s\n' "_pointer" ;;
    *) printf '%s\n' "" ;;
  esac
}

need BITIR_WORKDIR
need BITIR_MACHINE_BACKEND
need BITIR_MACHINE_RESULTS_ROOT
need BENCH
need BITIR_SOURCE_DIR

REPO_ROOT="${REPO_ROOT:-${BITIR_WORKDIR}}"
RUNNER="${REPO_ROOT}/HeCBench/tools/llvm17_inject/run_benchmark_injection.sh"
PLUGIN_BUILD="${REPO_ROOT}/HeCBench/tools/llvm17_inject/build.sh"
WORKLIST_TOOL="${REPO_ROOT}/HeCBench/tools/llvm17_inject/build_bench_worklist.py"

INJECT_TARGET="${INJECT_TARGET:-${BITIR_FAULT_MODEL_INJECT_TARGET:-result}}"
INT_FLOAT_ONLY="${INT_FLOAT_ONLY:-${BITIR_FAULT_MODEL_INT_FLOAT_ONLY:-1}}"
INCLUDE_CONSTANTS="${INCLUDE_CONSTANTS:-${BITIR_FAULT_MODEL_INCLUDE_CONSTANTS:-0}}"
PHASE="${PHASE:-${BITIR_FAULT_MODEL_PHASE:-float}}"
RUN_BASELINE="${RUN_BASELINE:-0}"
SKIP_EXISTING="${SKIP_EXISTING:-1}"
MAX_RUNS="${MAX_INJECTIONS:-${MAX_PAIRS:-0}}"
TRACE_REPEATS="${TRACE_REPEATS:-${BITIR_FAULT_MODEL_TRACE_REPEATS:-1}}"
SITE_LIST="${SITE_LIST:-${BITIR_SITE_LIST:-${BITIR_FAULT_MODEL_SITE_LIST:-}}}"

RESULTS_ROOT_REL="${BITIR_MACHINE_RESULTS_ROOT}"
if [[ -n "${RESULTS_SUBDIR_BASE:-}" ]]; then
  RESULTS_ROOT_REL="HeCBench/results/${RESULTS_SUBDIR_BASE}"
fi
RESULTS_DIR="${RESULTS_DIR:-${REPO_ROOT}/${RESULTS_ROOT_REL}/${BENCH}/${PHASE}}"
WORKLIST_SUFFIX="$(worklist_suffix)"
WORKLIST="${WORKLIST:-${RESULTS_DIR}/worklist${WORKLIST_SUFFIX}.csv}"
if [[ -n "${SITE_LIST}" && "${SITE_LIST}" != /* ]]; then
  SITE_LIST="${REPO_ROOT}/${SITE_LIST}"
fi

mkdir -p "${RESULTS_DIR}"
cd "${REPO_ROOT}"

if [[ ! -f "${RUNNER}" ]]; then
  echo "missing runner: ${RUNNER}" >&2
  exit 1
fi
if [[ ! -f "${WORKLIST_TOOL}" ]]; then
  echo "missing worklist tool: ${WORKLIST_TOOL}" >&2
  exit 1
fi

echo "[deploy] bench=${BENCH}"
echo "[deploy] backend=${BITIR_MACHINE_BACKEND}"
echo "[deploy] results=${RESULTS_DIR}"
echo "[deploy] target=${INJECT_TARGET}"

bash "${PLUGIN_BUILD}"

python3 "${WORKLIST_TOOL}" \
  --bench "${BENCH}" \
  --backend "${BITIR_MACHINE_BACKEND}" \
  --source-dir "${BITIR_SOURCE_DIR}" \
  --target "${INJECT_TARGET}" \
  --int-float-only "${INT_FLOAT_ONLY}" \
  --include-constants "${INCLUDE_CONSTANTS}" \
  --worklist "${WORKLIST}"

if [[ ! -s "${WORKLIST}" ]]; then
  echo "empty worklist: ${WORKLIST}" >&2
  exit 1
fi

if [[ "${RUN_BASELINE}" == "1" ]]; then
  IFS=, read -r _ baseline_site baseline_bit _ < <(tail -n +2 "${WORKLIST}" | head -n 1)
  if [[ -z "${baseline_site:-}" || -z "${baseline_bit:-}" ]]; then
    echo "failed to read first site from ${WORKLIST}" >&2
    exit 1
  fi
  echo "[deploy] baseline site=${baseline_site} bit=${baseline_bit}"
  BASELINE=1 SITE_ID="${baseline_site}" BIT_INDEX="${baseline_bit}" RESULTS_DIR="${RESULTS_DIR}" \
    bash "${RUNNER}"
fi

count=0
INPUT_LIST="${WORKLIST}"
if [[ -n "${SITE_LIST}" ]]; then
  if [[ ! -f "${SITE_LIST}" ]]; then
    echo "missing site list: ${SITE_LIST}" >&2
    exit 1
  fi
  INPUT_LIST="${SITE_LIST}"
fi

while IFS=, read -r a b c _; do
  site_id="${a}"
  bit_index="${b}"
  if [[ "${a}" =~ ^[0-9]+$ && "${b}" =~ ^[0-9]+$ && "${c:-}" =~ ^[0-9]+$ ]]; then
    site_id="${b}"
    bit_index="${c}"
  fi
  [[ "${site_id}" == "site_id" ]] && continue
  [[ "${site_id}" == "index" ]] && continue
  [[ "${site_id}" == "x_index" ]] && continue
  if [[ -z "${site_id}" || -z "${bit_index}" ]]; then
    continue
  fi
  if [[ "${MAX_RUNS}" != "0" && "${count}" -ge "${MAX_RUNS}" ]]; then
    break
  fi
  trial=1
  while [[ "${trial}" -le "${TRACE_REPEATS}" ]]; do
    echo "[deploy] site=${site_id} bit=${bit_index} trial=${trial}"
    BASELINE=0 SITE_ID="${site_id}" BIT_INDEX="${bit_index}" TRIAL_INDEX="${trial}" RESULTS_DIR="${RESULTS_DIR}" \
      SKIP_EXISTING="${SKIP_EXISTING}" bash "${RUNNER}"
    trial=$((trial + 1))
  done
  count=$((count + 1))
done < "${INPUT_LIST}"

echo "[deploy] completed ${count} injection sites with ${TRACE_REPEATS} trial(s) each"
