#!/bin/bash
#PBS -A UIC-HPC
#PBS -N jacobi_metrics_debug
#PBS -q debug
#PBS -l select=1:ncpus=32:ngpus=4:mem=128gb
#PBS -l filesystems=home:eagle
#PBS -l walltime=01:00:00
#PBS -o OUT_jacobi_metrics_debug.out
#PBS -e ERROR_jacobi_metrics_debug.err
#PBS -M mdunl6@uic.edu
#PBS -m abe

set -euo pipefail

export BENCH="jacobi"
export START_SITE="1"
export SKIP_EXISTING="0"
export COMPARE_MODE="exact"
export MISSING_ONLY=0
export MAX_PAIRS="30"
export RESULTS_SUBDIR="fi_metrics_debug"
export RESULTS_DIR_OVERRIDE="${PBS_O_WORKDIR:-$(pwd)}/HeCBench/results/fi_metrics_debug/jacobi/float"
export WORKLIST_PRUNED="${PBS_O_WORKDIR:-$(pwd)}/HeCBench/results/llvm17_inject/jacobi-sycl/worklist_sycl_aligned.csv"

# Build a small deterministic worklist for metrics validation.
python3 - <<'PY'
import csv, os
worklist = os.environ["WORKLIST_PRUNED"]
results_dir = os.environ["RESULTS_DIR_OVERRIDE"]
os.makedirs(results_dir, exist_ok=True)
out_path = os.path.join(results_dir, "worklist_head30.csv")
with open(worklist, newline="") as fh, open(out_path, "w", newline="") as out:
    r = csv.DictReader(fh)
    w = csv.DictWriter(out, fieldnames=list(r.fieldnames))
    w.writeheader()
    for i, row in enumerate(r):
        if i >= 30:
            break
        w.writerow(row)
print(f"[metrics-debug] wrote {out_path}")
PY

export WORKLIST="${RESULTS_DIR_OVERRIDE}/worklist_head30.csv"
export CPU_PER_GPU="8"

# use caching and reduced logging
export CACHE_DEVICE_IR=1
export GENERATE_IR_LL=0
export MONITOR_GPU=0

exec bash "${PBS_O_WORKDIR:-$(pwd)}/HeCBench/llvm17_inject_bench_sweep.pbs"
