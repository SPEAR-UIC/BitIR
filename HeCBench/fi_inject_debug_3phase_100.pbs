#!/bin/bash
#PBS -A UIC-HPC
#PBS -N fi_debug_3phase_100
#PBS -q debug
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l filesystems=home:eagle
#PBS -l walltime=01:00:00
#PBS -o OUT_fi_debug_3phase_100.out
#PBS -e ERROR_fi_debug_3phase_100.err
#PBS -M mdunl6@uic.edu
#PBS -m abe

set -euo pipefail

if [[ -z "${BENCH:-}" ]]; then
  echo "[error] BENCH must be set for debug run (e.g. BENCH=layout)"
  exit 2
fi
export BENCH
export PHASES="float operand pointer"
export WORKLIST_QUEUE=1
export MAX_PAIRS=100
export SKIP_EXISTING=0
export MISSING_ONLY=0
export RESULTS_SUBDIR_BASE="fi_debug_3phase"

# caching + reduced logging
export CACHE_DEVICE_IR=1
export GENERATE_IR_LL=0
export MONITOR_GPU=1
export MONITOR_INTERVAL=30

exec bash "${PBS_O_WORKDIR:-$(pwd)}/HeCBench/llvm17_inject_bench_sweep.pbs"
