#!/bin/bash
#PBS -A UIC-HPC
#PBS -N matrix_rotate_llfi
#PBS -q debug
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l filesystems=home:eagle
#PBS -l walltime=01:00:00
#PBS -o OUT_matrix_rotate_llfi.out
#PBS -e ERROR_matrix_rotate_llfi.err

set -euo pipefail

if command -v module &> /dev/null; then
  module use /soft/modulefiles
  module purge
  module load spack-pe-base cmake
  for m in ${MODULE_LIST:-cuda/12.6}; do
    module load "$m"
  done
fi

cd "$PBS_O_WORKDIR"

REPO_DIR="$PBS_O_WORKDIR"
LLFI_ROOT="${LLFI_ROOT:-$REPO_DIR/../LLFI-GPU}"
MATRIX_SIZE="${MATRIX_SIZE:-8192}"
MATRIX_REPEAT="${MATRIX_REPEAT:-10}"
GOLDEN_PATH="${GOLDEN_PATH:-$REPO_DIR/Polaris_Golden_Outputs/matrix-rotate_${MATRIX_SIZE}_${MATRIX_REPEAT}.bin}"
OUTPUT_ROOT="${OUTPUT_ROOT:-$REPO_DIR/results/llfi/matrix-rotate/full_sweep_job_$(date +%Y%m%d_%H%M%S)}"
CUDA_ARCH="${CUDA_ARCH:-sm_80}"

if [[ ! -d "$LLFI_ROOT" ]]; then
  echo "LLFI root not found: $LLFI_ROOT"
  exit 1
fi

if [[ ! -f "$GOLDEN_PATH" ]]; then
  echo "Golden matrix dump missing: $GOLDEN_PATH"
  echo "Generate it first via target_golden_outputs.pbs (matrix-rotate run)."
  exit 1
fi

mkdir -p "$OUTPUT_ROOT"

CMD=(python3 tools/matrix_rotate_llfi_sweep.py
  --llfi-root "$LLFI_ROOT"
  --golden "$GOLDEN_PATH"
  --size "$MATRIX_SIZE"
  --repeat "$MATRIX_REPEAT"
  --cuda-arch "$CUDA_ARCH"
  --output-root "$OUTPUT_ROOT"
)

if [[ -n "${MAX_SITES:-}" ]]; then
  CMD+=(--max-sites "$MAX_SITES")
fi

if [[ -n "${CMAKE_ARGS:-}" ]]; then
  for arg in $CMAKE_ARGS; do
    CMD+=(--cmake-arg "$arg")
  done
fi

echo "Launching LLFI sweep with output root $OUTPUT_ROOT"
"${CMD[@]}"
