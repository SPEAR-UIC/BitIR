#!/bin/bash
#PBS -A UIC-HPC
#PBS -N llvm_inject_matrix_rotate_single
#PBS -q debug
#PBS -l select=1:ncpus=8:ngpus=1:mem=16gb
#PBS -l filesystems=home:eagle
#PBS -l walltime=01:00:00
#PBS -o OUT_llvm_inject_matrix_rotate_single.out
#PBS -e ERROR_llvm_inject_matrix_rotate_single.err

set -euo pipefail

if command -v module &> /dev/null; then
  module use /soft/modulefiles
  module purge
  module load spack-pe-base cmake
  module load cudatoolkit-standalone/11.8.0
  module load llvm/release-17.0.0
fi

cd "$PBS_O_WORKDIR"

REPO_ROOT="${REPO_ROOT:-$PBS_O_WORKDIR}"
export CUDA_HOME="${CUDA_HOME:-/soft/compilers/cudatoolkit/cuda-11.8.0}"
export PATH="${CUDA_HOME}/bin:${PATH:-}"
export LD_LIBRARY_PATH="${CUDA_HOME}/lib64:${LD_LIBRARY_PATH:-}"
export CUDA_DEVICE_ORDER="${CUDA_DEVICE_ORDER:-PCI_BUS_ID}"
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"
export HECBENCH_GPU_DEBUG="${HECBENCH_GPU_DEBUG:-1}"

SITE_ID="${SITE_ID:-1}"
BIT_INDEX="${BIT_INDEX:-0}"
ABS_TOL="${ABS_TOL:-0.0}"
REL_TOL="${REL_TOL:-0.0}"

echo "[env] REPO_ROOT=${REPO_ROOT}"
echo "[env] CUDA_HOME=${CUDA_HOME}"
echo "[env] CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES}"
echo "[env] HECBENCH_GPU_DEBUG=${HECBENCH_GPU_DEBUG}"
echo "[env] SITE_ID=${SITE_ID} BIT_INDEX=${BIT_INDEX} ABS_TOL=${ABS_TOL} REL_TOL=${REL_TOL}"
echo "[env] hostname=$(hostname)"
echo "[env] start=$(date)"

if command -v nvidia-smi &> /dev/null; then
  nvidia-smi -L
  nvidia-smi --query-gpu=timestamp,uuid,utilization.gpu,utilization.memory,memory.used --format=csv || true
fi

bash "${REPO_ROOT}/HeCBench/tools/llvm17_inject/build.sh"

GPU_MONITOR_PID=""
start_gpu_monitor() {
  if ! command -v nvidia-smi &> /dev/null; then
    return
  fi
  (
    while true; do
      echo "[gpu-monitor] $(date +"%Y-%m-%d %H:%M:%S")"
      nvidia-smi --query-compute-apps=pid,process_name,gpu_uuid,used_gpu_memory --format=csv || true
      nvidia-smi --query-gpu=timestamp,uuid,utilization.gpu,utilization.memory,memory.used --format=csv || true
      nvidia-smi pmon -c 1 || true
      sleep 0.5
    done
  ) >> "OUT_llvm_inject_matrix_rotate_single.out" &
  GPU_MONITOR_PID=$!
}

stop_gpu_monitor() {
  if [[ -n "${GPU_MONITOR_PID}" ]]; then
    kill "${GPU_MONITOR_PID}" 2>/dev/null || true
    wait "${GPU_MONITOR_PID}" 2>/dev/null || true
    GPU_MONITOR_PID=""
  fi
}

start_gpu_monitor

SITE_ID="${SITE_ID}" \
BIT_INDEX="${BIT_INDEX}" \
ABS_TOL="${ABS_TOL}" \
REL_TOL="${REL_TOL}" \
CUDA_HOME="${CUDA_HOME}" \
REPO_ROOT="${REPO_ROOT}" \
bash "${REPO_ROOT}/HeCBench/tools/llvm17_inject/run_matrix_rotate_injection.sh"

stop_gpu_monitor

if command -v nvidia-smi &> /dev/null; then
  nvidia-smi --query-gpu=timestamp,uuid,utilization.gpu,utilization.memory,memory.used --format=csv || true
fi

echo "[env] end=$(date)"
