#!/bin/bash
#PBS -A UIC-HPC
#PBS -N llvm_inject_matrix_rotate_sweep
#PBS -q debug
#PBS -l select=1:ncpus=1:ngpus=2:mem=16gb
#PBS -l filesystems=home:eagle
#PBS -l walltime=01:00:00
#PBS -o OUT_llvm_inject_matrix_rotate_sweep.out
#PBS -e ERROR_llvm_inject_matrix_rotate_sweep.err

set -euo pipefail

if command -v module &> /dev/null; then
  module use /soft/modulefiles
  module purge
  module load spack-pe-base cmake
  module load cudatoolkit-standalone/11.8.0
  module load llvm/release-17.0.0
fi

cd "$PBS_O_WORKDIR"

REPO_ROOT="${REPO_ROOT:-$PBS_O_WORKDIR}"
export CUDA_HOME="${CUDA_HOME:-/soft/compilers/cudatoolkit/cuda-11.8.0}"
export PATH="${CUDA_HOME}/bin:${PATH:-}"
export LD_LIBRARY_PATH="${CUDA_HOME}/lib64:${LD_LIBRARY_PATH:-}"
export CUDA_DEVICE_ORDER="${CUDA_DEVICE_ORDER:-PCI_BUS_ID}"
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-}"
export HECBENCH_GPU_DEBUG="${HECBENCH_GPU_DEBUG:-0}"

ABS_TOL="${ABS_TOL:-1e-5}"
REL_TOL="${REL_TOL:-1e-6}"

WORKLIST="${REPO_ROOT}/HeCBench/results/llvm17_inject/matrix-rotate/worklist.csv"
RESULTS_DIR="${REPO_ROOT}/HeCBench/results/llvm17_inject/matrix-rotate"
mkdir -p "${RESULTS_DIR}"

echo "[env] REPO_ROOT=${REPO_ROOT}"
echo "[env] CUDA_HOME=${CUDA_HOME}"
echo "[env] CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES}"
echo "[env] ABS_TOL=${ABS_TOL} REL_TOL=${REL_TOL}"
echo "[env] start=$(date)"

if command -v nvidia-smi &> /dev/null; then
  echo "[env] nvidia-smi -L"
  nvidia-smi -L || true
fi

if [[ -n "${CUDA_VISIBLE_DEVICES}" ]]; then
  GPU_COUNT=$(echo "${CUDA_VISIBLE_DEVICES}" | awk -F',' '{print NF}')
else
  if command -v nvidia-smi &> /dev/null; then
    GPU_COUNT=$(nvidia-smi -L | wc -l)
  else
    GPU_COUNT=1
  fi
fi
export GPU_COUNT
echo "[env] GPU_COUNT=${GPU_COUNT}"

bash "${REPO_ROOT}/HeCBench/tools/llvm17_inject/build.sh"

if [[ ! -s "${WORKLIST}" || "${REBUILD_WORKLIST:-0}" -eq 1 ]]; then
  python3 "${REPO_ROOT}/HeCBench/tools/llvm17_inject/build_matrix_rotate_worklist.py"
fi

if [[ -n "${PBS_NODEFILE:-}" && -f "${PBS_NODEFILE}" ]]; then
  NODE_COUNT=$(uniq "${PBS_NODEFILE}" | wc -l)
else
  NODE_COUNT="${NODE_COUNT:-1}"
fi
echo "[env] NODE_COUNT=${NODE_COUNT}"

if [[ "${WORKER:-0}" -eq 1 ]]; then
  TASK_ID="${TASK_ID:-0}"
  TOTAL_WORKERS=$((NODE_COUNT * GPU_COUNT))
  echo "[worker] task=${TASK_ID} gpus=${GPU_COUNT} total_workers=${TOTAL_WORKERS}"

  run_worker_gpu() {
    local gpu_id=$1
    local worker_rank=$((TASK_ID * GPU_COUNT + gpu_id))
    local out_dir_base
    if [[ -n "${PBS_JOBTMP:-}" && -d "${PBS_JOBTMP}" ]]; then
      out_dir_base="${PBS_JOBTMP}"
    elif [[ -n "${TMPDIR:-}" && -d "${TMPDIR}" ]]; then
      out_dir_base="${TMPDIR}"
    else
      out_dir_base="/tmp"
    fi
    local out_dir="${out_dir_base}/llvm17-inject-matrix-rotate-node${TASK_ID}_gpu${gpu_id}"
    local csv="${RESULTS_DIR}/summary_node${TASK_ID}_gpu${gpu_id}.csv"
    echo "[worker] rank=${worker_rank} gpu=${gpu_id} out_dir=${out_dir}"

    while IFS=, read -r idx site bit bitwidth kind opcode; do
      if [[ "${idx}" == "index" || -z "${idx}" ]]; then
        continue
      fi
      if (( (idx - 1) % TOTAL_WORKERS != worker_rank )); then
        continue
      fi
      CUDA_VISIBLE_DEVICES="${gpu_id}" \
      SITE_ID="${site}" \
      BIT_INDEX="${bit}" \
      ABS_TOL="${ABS_TOL}" \
      REL_TOL="${REL_TOL}" \
      OUT_DIR="${out_dir}" \
      RESULTS_DIR="${RESULTS_DIR}" \
      CSV="${csv}" \
      REPO_ROOT="${REPO_ROOT}" \
      CUDA_HOME="${CUDA_HOME}" \
      bash "${REPO_ROOT}/HeCBench/tools/llvm17_inject/run_matrix_rotate_injection.sh"
    done < "${WORKLIST}"
  }

  for gpu_id in $(seq 0 $((GPU_COUNT - 1))); do
    run_worker_gpu "${gpu_id}" &
  done
  wait
  exit 0
fi

if command -v pbsdsh &> /dev/null; then
  for i in $(seq 0 $((NODE_COUNT - 1))); do
    pbsdsh -n "$i" -- bash -lc "WORKER=1 TASK_ID=${i} NODE_COUNT=${NODE_COUNT} GPU_COUNT=${GPU_COUNT} ABS_TOL=${ABS_TOL} REL_TOL=${REL_TOL} CUDA_HOME=${CUDA_HOME} REPO_ROOT=${REPO_ROOT} PBS_JOBTMP=${PBS_JOBTMP:-} TMPDIR=${TMPDIR:-} bash ${REPO_ROOT}/HeCBench/llvm17_inject_matrix_rotate_sweep.pbs" &
  done
  wait
else
  echo "pbsdsh not available; running single-node worker."
  WORKER=1 TASK_ID=0 NODE_COUNT=1 GPU_COUNT="${GPU_COUNT}" bash "${REPO_ROOT}/HeCBench/llvm17_inject_matrix_rotate_sweep.pbs"
fi

SUMMARY_ALL="${RESULTS_DIR}/summary.csv"
SUMMARY_LOG="${RESULTS_DIR}/summary_counts.txt"
if ls "${RESULTS_DIR}"/summary_node*_gpu*.csv >/dev/null 2>&1; then
  export RESULTS_DIR
  {
    echo "site_id,bit_index,result,exit_code,stdout,stderr,dump"
    for f in "${RESULTS_DIR}"/summary_node*_gpu*.csv; do
      tail -n +2 "$f" || true
    done
  } > "${SUMMARY_ALL}"

  python3 - <<'PY'
import csv
from collections import Counter
import os

summary = os.path.join(os.environ["RESULTS_DIR"], "summary.csv")
counts = Counter()
total = 0
with open(summary, newline="") as fh:
    reader = csv.DictReader(fh)
    for row in reader:
        total += 1
        counts[row.get("result","UNKNOWN")] += 1

with open(os.path.join(os.environ["RESULTS_DIR"], "summary_counts.txt"), "w") as out:
    out.write(f"total={total}\n")
    for key in ("MASKED","SDC","FAILURE"):
        out.write(f"{key}={counts.get(key,0)}\n")
    others = total - sum(counts.get(k,0) for k in ("MASKED","SDC","FAILURE"))
    out.write(f"OTHER={others}\n")
PY
fi

echo "[env] end=$(date)"
