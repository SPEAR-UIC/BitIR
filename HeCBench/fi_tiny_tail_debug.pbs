#!/bin/bash
#PBS -A UIC-HPC
#PBS -N fi_tiny_tail_debug
#PBS -q debug
#PBS -l select=1:ncpus=32:ngpus=4:mem=128gb
#PBS -l filesystems=home:eagle
#PBS -l walltime=01:00:00
#PBS -o OUT_tiny_tail_debug.out
#PBS -e ERROR_tiny_tail_debug.err
#PBS -M mdunl6@uic.edu
#PBS -m n

set -euo pipefail

ROOT="${PBS_O_WORKDIR:-$(pwd)}"
SWEEP="${ROOT}/HeCBench/llvm17_inject_bench_sweep.pbs"

run_phase() {
  local bench="$1"
  local phase="$2"
  local compare="$3"
  local target="$4"
  echo "[tiny-debug] start bench=${bench} phase=${phase} compare=${compare} target=${target} ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  BENCH="${bench}" \
  PHASE="${phase}" \
  COMPARE_MODE="${compare}" \
  INJECT_TARGET="${target}" \
  RESULTS_SUBDIR="llvm17_inject" \
  WORKLIST_QUEUE=1 \
  MISSING_ONLY=1 \
  SKIP_EXISTING=0 \
  bash "${SWEEP}" || true
  echo "[tiny-debug] end bench=${bench} phase=${phase} ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
}

run_phase "layout" "float" "exact" "result"
run_phase "layout" "operand" "exact" "operand"
run_phase "matrix-rotate" "float" "float" "result"
run_phase "matrix-rotate" "operand" "exact" "operand"
run_phase "pathfinder" "float" "exact" "result"
run_phase "pathfinder" "operand" "exact" "operand"
