#!/bin/bash
#PBS -A UIC-HPC
#PBS -N aurora_sycl_golden
#PBS -q debug
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l filesystems=home
#PBS -l walltime=01:00:00
#PBS -o OUT_sycl_golden.out
#PBS -e ERROR_sycl_golden.err

set -euo pipefail

if command -v module &> /dev/null; then
  module purge
  module use /opt/aurora/25.190.0/spack/unified/0.10.1/install/modulefiles/Core 2>/dev/null || true
  module use /opt/aurora/25.190.0/modulefiles 2>/dev/null || true
  module load cmake/3.31.8 2>/dev/null || module load cmake 2>/dev/null || true
  module load ninja/1.12.1 2>/dev/null || module load ninja 2>/dev/null || true
  module load oneapi/release/2025.2.0 2>/dev/null || \
  module load oneapi/release/2025.0.5 2>/dev/null || \
  module load oneapi/release/2024.2.1 2>/dev/null || \
  module load oneapi/eng-compiler/2024.07.30.002 2>/dev/null || true
fi

cd "$PBS_O_WORKDIR"

REPO_DIR="$PBS_O_WORKDIR"
HECBENCH_ROOT="${HECBENCH_ROOT:-${REPO_DIR}/HeCBench}"
BUILD_DIR="${BUILD_DIR:-${HECBENCH_ROOT}/build/sycl-intel-golden}"
OUTPUT_ROOT="${OUTPUT_ROOT:-${REPO_DIR}/Aurora_Sycl_Golden_Outputs_smoke}"
mkdir -p "$OUTPUT_ROOT"

export SYCL_DEVICE_FILTER="${SYCL_DEVICE_FILTER:-level_zero:gpu}"
export ONEAPI_DEVICE_SELECTOR="${ONEAPI_DEVICE_SELECTOR:-level_zero:gpu}"
export SYCL_UR_TRACE="${SYCL_UR_TRACE:-0}"
export ZE_ENABLE_VALIDATION_LAYER="${ZE_ENABLE_VALIDATION_LAYER:-0}"
export ZE_ENABLE_PARAMETER_VALIDATION="${ZE_ENABLE_PARAMETER_VALIDATION:-0}"
export ZE_DEBUG="${ZE_DEBUG:-0}"
export SYCL_CACHE_PERSISTENT="${SYCL_CACHE_PERSISTENT:-1}"
export HECBENCH_GPU_DEBUG="${HECBENCH_GPU_DEBUG:-0}"

timestamp() {
  date +"%Y-%m-%d %H:%M:%S"
}

SUMMARY_FILE="$OUTPUT_ROOT/run_summary.txt"
{
  echo "Aurora SYCL golden runs"
  echo "Repository : $REPO_DIR"
  echo "Build dir  : $BUILD_DIR"
  echo "Output dir : $OUTPUT_ROOT"
  echo "Start time : $(timestamp)"
} > "$SUMMARY_FILE"

append_summary() {
  echo "[$(timestamp)] $1" >> "$SUMMARY_FILE"
}

GOLDEN_CXX_FLAGS="${GOLDEN_CXX_FLAGS:--DUSE_GPU -O0 -g0}"

cmake -S "${HECBENCH_ROOT}" -B "${BUILD_DIR}" -G Ninja \
  -DHECBENCH_ENABLE_SYCL=ON \
  -DHECBENCH_ENABLE_CUDA=OFF \
  -DHECBENCH_ENABLE_HIP=OFF \
  -DHECBENCH_ENABLE_OPENMP=OFF \
  -DHECBENCH_SYCL_TARGET=spir64 \
  -DCMAKE_C_COMPILER=icx \
  -DCMAKE_CXX_COMPILER=icpx \
  -DCMAKE_CXX_FLAGS="${GOLDEN_CXX_FLAGS}"

ALL_BENCHES=(matrix-rotate jacobi layout dense-embedding pathfinder entropy colorwheel randomAccess)
if [[ -n "${BENCH_ONLY_FILE:-}" && -f "${BENCH_ONLY_FILE}" ]]; then
  mapfile -t BENCH_LIST < "${BENCH_ONLY_FILE}"
elif [[ -n "${BENCH_ONLY:-}" ]]; then
  BENCH_ONLY_NORM="${BENCH_ONLY//,/ }"
  read -r -a BENCH_LIST <<< "${BENCH_ONLY_NORM}"
else
  BENCH_LIST=("${ALL_BENCHES[@]}")
fi

has_bench() {
  local name="$1"
  printf '%s\n' "${BENCH_LIST[@]}" | grep -qx "${name}"
}

targets=()
for b in "${BENCH_LIST[@]}"; do
  targets+=("${b}-sycl")
done

cmake --build "${BUILD_DIR}" --target "${targets[@]}"

run_one() {
  local bench="$1"
  shift
  local dump="$1"
  shift
  local bin="${BUILD_DIR}/bin/sycl/${bench}"
  local log="${OUTPUT_ROOT}/${bench}.log"
  local err="${OUTPUT_ROOT}/${bench}.err"

  echo "[$(timestamp)] Running ${bench} (SYCL): ${bin} $* ${dump}" | tee "$log"
  set +e
  HECBENCH_LLFI_FORCE_DUMP=1 "${bin}" "$@" "${dump}" \
    > >(tee -a "$log") 2> >(tee -a "$err" >&2)
  local status=$?
  set -e

  if [[ $status -ne 0 ]]; then
    echo "[$(timestamp)] ${bench} FAILED (status $status)" | tee -a "$log"
    append_summary "${bench}: FAILED"
    return $status
  fi
  if [[ ! -f "${dump}" ]]; then
    echo "[$(timestamp)] ${bench} dump missing: ${dump}" | tee -a "$log"
    append_summary "${bench}: dump missing"
    return 1
  fi
  append_summary "${bench}: log=$(basename "$log")"
  return 0
}

MATRIX_SIZE="${MATRIX_SIZE:-2048}"
MATRIX_REPEAT="${MATRIX_REPEAT:-2}"
if has_bench "matrix-rotate"; then
  run_one "matrix-rotate" "${OUTPUT_ROOT}/matrix-rotate_${MATRIX_SIZE}_${MATRIX_REPEAT}.bin" \
    "${MATRIX_SIZE}" "${MATRIX_REPEAT}"
fi

if has_bench "jacobi"; then
  run_one "jacobi" "${OUTPUT_ROOT}/jacobi.bin"
fi

LAYOUT_REPEAT="${LAYOUT_REPEAT:-10}"
if has_bench "layout"; then
  run_one "layout" "${OUTPUT_ROOT}/layout.bin" "${LAYOUT_REPEAT}"
fi

DENSE_ROWS="${DENSE_ROWS:-2000}"
DENSE_BATCH="${DENSE_BATCH:-32}"
DENSE_REPEAT="${DENSE_REPEAT:-2}"
if has_bench "dense-embedding"; then
  run_one "dense-embedding" "${OUTPUT_ROOT}/dense-embedding.bin" "${DENSE_ROWS}" "${DENSE_BATCH}" "${DENSE_REPEAT}"
fi

PATHFINDER_COLS="${PATHFINDER_COLS:-500}"
PATHFINDER_ROWS="${PATHFINDER_ROWS:-500}"
PATHFINDER_PYRAMID="${PATHFINDER_PYRAMID:-32}"
if has_bench "pathfinder"; then
  run_one "pathfinder" "${OUTPUT_ROOT}/pathfinder.bin" "${PATHFINDER_COLS}" "${PATHFINDER_ROWS}" "${PATHFINDER_PYRAMID}"
fi

ENTROPY_WIDTH="${ENTROPY_WIDTH:-2048}"
ENTROPY_HEIGHT="${ENTROPY_HEIGHT:-2048}"
ENTROPY_REPEAT="${ENTROPY_REPEAT:-2}"
if has_bench "entropy"; then
  run_one "entropy" "${OUTPUT_ROOT}/entropy.bin" "${ENTROPY_WIDTH}" "${ENTROPY_HEIGHT}" "${ENTROPY_REPEAT}"
fi

COLORWHEEL_RANGE="${COLORWHEEL_RANGE:-1.0}"
COLORWHEEL_SIZE="${COLORWHEEL_SIZE:-2048}"
COLORWHEEL_REPEAT="${COLORWHEEL_REPEAT:-2}"
if has_bench "colorwheel"; then
  run_one "colorwheel" "${OUTPUT_ROOT}/colorwheel.bin" "${COLORWHEEL_RANGE}" "${COLORWHEEL_SIZE}" "${COLORWHEEL_REPEAT}"
fi

RANDOMACCESS_REPEAT="${RANDOMACCESS_REPEAT:-1}"
if has_bench "randomAccess"; then
  run_one "randomAccess" "${OUTPUT_ROOT}/randomAccess.bin" "${RANDOMACCESS_REPEAT}"
fi

append_summary "All SYCL goldens complete"
