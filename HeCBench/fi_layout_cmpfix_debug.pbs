#!/bin/bash
#PBS -A UIC-HPC
#PBS -N layout_cmpfix_debug
#PBS -q debug
#PBS -l select=1:ncpus=32:ngpus=4:mem=64gb
#PBS -l filesystems=home:eagle
#PBS -l walltime=01:00:00
#PBS -o OUT_layout_cmpfix_debug.out
#PBS -e ERROR_layout_cmpfix_debug.err
#PBS -M mdunl6@uic.edu
#PBS -m abe

set -euo pipefail

REPO_ROOT="${PBS_O_WORKDIR:-$(pwd)}"
SWEEP="${REPO_ROOT}/HeCBench/llvm17_inject_bench_sweep.pbs"
BENCH="layout"

run_phase() {
  local phase="$1"
  local target="$2"
  local wl="${REPO_ROOT}/HeCBench/results/llvm17_inject/${BENCH}/${phase}/worklist_missing_compare.csv"
  if [[ ! -f "${wl}" ]]; then
    echo "[cmpfix] missing worklist: ${wl}"
    return 0
  fi
  local n
  n=$(awk 'NR>1' "${wl}" | wc -l)
  echo "[cmpfix] ${BENCH}/${phase} pairs=${n} worklist=${wl}"
  if [[ "${n}" -eq 0 ]]; then
    return 0
  fi

  BENCH="${BENCH}" \
  PHASE="${phase}" \
  INJECT_TARGET="${target}" \
  WORKLIST="${wl}" \
  MISSING_ONLY=0 \
  SKIP_EXISTING=0 \
  WORKLIST_QUEUE=1 \
  RESULTS_SUBDIR_BASE=llvm17_inject \
  CPU_PER_GPU=8 \
  CACHE_DEVICE_IR=1 \
  GENERATE_IR_LL=0 \
  MONITOR_GPU=0 \
  MONITOR_INTERVAL=300 \
  bash "${SWEEP}"
}

run_phase float result
run_phase operand operand
run_phase pointer pointer
