#!/bin/bash
#PBS -A UIC-HPC
#PBS -N baseline_all_sycl_dbg
#PBS -q debug
#PBS -l select=1:ncpus=12:ngpus=1:mem=32gb
#PBS -l filesystems=home
#PBS -l walltime=01:00:00
#PBS -o OUT_baseline_all_sycl.out
#PBS -e ERROR_baseline_all_sycl.err

set -euo pipefail

cd "$PBS_O_WORKDIR"

ALL_BENCHES=(matrix-rotate jacobi layout dense-embedding pathfinder entropy colorwheel randomAccess)
if [[ -n "${BENCH_ONLY:-}" ]]; then
  IFS=',' read -r -a BENCHES <<< "${BENCH_ONLY}"
else
  BENCHES=("${ALL_BENCHES[@]}")
fi

for bench in "${BENCHES[@]}"; do
  echo "[baseline] bench=${bench}"
  BENCH="${bench}" \
  RUN_BASELINE=1 \
  BASELINE_ONLY=1 \
  MISSING_ONLY=0 \
  EXCLUDE_GIT_REF="${EXCLUDE_GIT_REF:-origin/intel_aurora}" \
  bash "${PBS_O_WORKDIR}/HeCBench/llvm17_inject_bench_sweep_sycl_debug.pbs"
done
