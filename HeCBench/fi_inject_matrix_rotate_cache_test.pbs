#!/bin/bash
#PBS -A UIC-HPC
#PBS -N matrix_rotate_cache_test
#PBS -q debug
#PBS -l select=1:ncpus=32:ngpus=4:mem=64gb
#PBS -l filesystems=home:eagle
#PBS -l walltime=01:00:00
#PBS -o OUT_matrix_rotate_cache_test.out
#PBS -e ERROR_matrix_rotate_cache_test.err
#PBS -M mdunl6@uic.edu
#PBS -m abe

set -euo pipefail

export BENCH="matrix-rotate"
export WORKLIST="${PBS_O_WORKDIR:-$(pwd)}/HeCBench/results/llvm17_inject/matrix-rotate/worklist_cache_test.csv"
export START_SITE=1
export SKIP_EXISTING=0
export COMPARE_MODE=exact

# force output to timing subdir
export RESULTS_SUBDIR="${RESULTS_SUBDIR:-fi_cache_test_on_timing}"

# caching + reduced logging
export CACHE_DEVICE_IR="${CACHE_DEVICE_IR:-1}"
export GENERATE_IR_LL=0
export MONITOR_GPU=0
export MONITOR_INTERVAL=300
export DEBUG_WORKLIST=1

echo "[cache-test] start=$(date +"%Y-%m-%d %H:%M:%S")"

exec bash "${PBS_O_WORKDIR:-$(pwd)}/HeCBench/llvm17_inject_bench_sweep.pbs"
