#!/usr/bin/env bash
set -euo pipefail

# Inject LLFI's nvcc interposition layer before invoking the real compiler.
# Allow PBS/job scripts to override how the cicc interposer modifies IR.
export CICC_MODIFY_OPT_MODULE="${CICC_MODIFY_OPT_MODULE:-1}"
export CICC_MODIFY_UNOPT_MODULE="${CICC_MODIFY_UNOPT_MODULE:-0}"

LLFI_PRELOAD="@LLFI_PRELOAD@"
LLFI_PREV_LAUNCHER="@LLFI_PREV_LAUNCHER@"

if [[ -n "${LLFI_PRELOAD}" ]]; then
    _llfi_preload_first="${LLFI_PRELOAD%%:*}"
    _llfi_preload_dir="$(dirname "${_llfi_preload_first}")"
    if [[ -f "${_llfi_preload_dir}/libcicc.so" && ! -f "./libcicc.so" ]]; then
        cp -f "${_llfi_preload_dir}/libcicc.so" ./libcicc.so
    fi
fi

LLFI_PRELOAD_NVCC="${LLFI_PRELOAD%%:*}"

echo "[llfi-nvcc-wrapper] pwd=$(pwd)" >&2
if [[ -f "./libcicc.so" ]]; then
    ls -l ./libcicc.so >&2
else
    echo "[llfi-nvcc-wrapper] libcicc.so not found in pwd" >&2
fi
env | grep -E '^(CICC_|LLFI_|CUDA_|CUDAToolkit_ROOT=|CMAKE_CUDA_COMPILER=)' >&2 || true

if [[ -n "${LD_PRELOAD:-}" ]]; then
    export LD_PRELOAD="${LLFI_PRELOAD_NVCC}:${LD_PRELOAD}"
else
    export LD_PRELOAD="${LLFI_PRELOAD_NVCC}"
fi

if [[ -n "${LLFI_PREV_LAUNCHER}" ]]; then
    IFS=';' read -r -a _llfi_prev_launcher_array <<< "${LLFI_PREV_LAUNCHER}"
    if command -v timeout &> /dev/null && [[ -n "${NVCC_TIMEOUT_SECONDS:-}" ]]; then
        exec timeout --preserve-status "${NVCC_TIMEOUT_SECONDS}" "${_llfi_prev_launcher_array[@]}" "$@"
    else
        exec "${_llfi_prev_launcher_array[@]}" "$@"
    fi
else
    if command -v timeout &> /dev/null && [[ -n "${NVCC_TIMEOUT_SECONDS:-}" ]]; then
        exec timeout --preserve-status "${NVCC_TIMEOUT_SECONDS}" "$@"
    else
        exec "$@"
    fi
fi
