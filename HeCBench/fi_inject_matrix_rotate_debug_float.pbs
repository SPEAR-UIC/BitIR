#!/bin/bash
#PBS -A UIC-HPC
#PBS -N fi_debug_matrix_rotate_float
#PBS -q debug
#PBS -l select=1:ncpus=32:ngpus=4:mem=128gb
#PBS -l filesystems=home:eagle
#PBS -l walltime=01:00:00
#PBS -o OUT_matrix_rotate_float_debug.out
#PBS -e ERROR_matrix_rotate_float_debug.err
#PBS -M mdunl6@uic.edu
#PBS -m abe

set -euo pipefail

export BENCH="matrix-rotate"
export PHASE="float"
export PHASES=""
export RESULTS_SUBDIR="llvm17_inject"
export REBUILD_PRUNED_WORKLIST=1
export REBUILD_WORKLIST=0
export MISSING_ONLY=0
export WORKLIST_QUEUE=1
export MAX_PAIRS=0
export MONITOR_GPU=1
export MONITOR_INTERVAL=60

SCRIPT="${PBS_O_WORKDIR:-$(pwd)}/HeCBench/llvm17_inject_bench_sweep.pbs"

# Build missing list explicitly (avoid missing-only path inside sweep).
export RESULTS_DIR="${PBS_O_WORKDIR:-$(pwd)}/HeCBench/results/llvm17_inject/matrix-rotate/float"
export PRUNED="${RESULTS_DIR}/worklist_pruned.csv"
export MISSING="${RESULTS_DIR}/worklist_missing.csv"
python3 - <<'PY'
import csv, os
results_dir = os.environ["RESULTS_DIR"]
worklist = os.environ["PRUNED"]
missing_path = os.environ["MISSING"]
with open(worklist, newline="") as fh, open(missing_path, "w", newline="") as out:
    r = csv.DictReader(fh)
    if not r.fieldnames:
        raise SystemExit("missing headers in worklist")
    w = csv.DictWriter(out, fieldnames=list(r.fieldnames))
    w.writeheader()
    for row in r:
        try:
            key = (int(row["site_id"]), int(row["bit_index"]))
        except Exception:
            continue
        out_path = os.path.join(results_dir, f"site{key[0]}_bit{key[1]}.out")
        if (not os.path.exists(out_path)) or os.path.getsize(out_path) == 0:
            w.writerow(row)
print(f"[missing-only] wrote {missing_path}")
PY

export WORKLIST="${MISSING}"
bash "${SCRIPT}" --queue-only
WORKER=1 TASK_ID=0 NODE_COUNT=1 GPU_COUNT=4 bash "${SCRIPT}"
